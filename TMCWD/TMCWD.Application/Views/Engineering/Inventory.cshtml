<!-- End Update Quantity Modal -->

<script type="text/javascript">

    var deactivateLinks = document.getElementsByClassName("lnkDeactivate");
    var addQuantityLinks = document.getElementsByClassName("add-quantity");

    [...deactivateLinks].forEach((link) => {
        link.addEventListener("click", (evt) => {
            evt.preventDefault();
            var id = evt.target.parentElement.dataset.id;

            var deactivateModal = new ModalDialog({
                type: 'deactivate',
                title: 'Deactivate Inventory',
                content: 'Are you sure you want to deactivate inventory? All of inventory data will be permanently removed. This action cannot be undone.',
                submitCallback: () => {
                    window.location.href = '@Url.Action("DeactivateInventory", "Engineering")' + '?inventoryId=' + id + '&userId=' + '@Model.CurrentUser.Id';
                }
            });

            deactivateModal.show();
            
            // showModalDialog({
            //     type: 'deactivate',
            //     submitUrl: '@Url.Action("DeactivateInventory", "Engineering")' + '?inventoryId=' + id + '&userId=' + '@Model.CurrentUser.Id',
            //     title: 'Deactivate Inventory',
            //     content: 'Are you sure you want to deactivate inventory? All of inventory data will be permanently removed. This action cannot be undone.'
            // });
        });
    });

    [...addQuantityLinks].forEach((link) => {
        link.addEventListener("click", (evt) => {
            evt.preventDefault();
            var itemId = evt.target.parentElement.dataset.id;
            var itemName = evt.target.parentElement.dataset.itemname;
            var quantity = evt.target.parentElement.dataset.quantity;
            var content = 'Current Quantity: ' + quantity;

            var numberDialog = new ModalDialog({
                type: 'number',
                title: itemName,
                content: content,
                textTitle: 'New Value',
                submitCallback: (quantity) => {
                    window.location.href = '@Url.Action("UpdateInventoryQuantity", "Engineering")' + '?itemId=' + itemId + '&newQuantity=' + quantity + '&currentUserId=' + currentUserId;
                }
            });

            numberDialog.show();

            // showModalDialog({
            //     type: 'quantity',
