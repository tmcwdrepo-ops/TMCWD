@{
    Layout = "_insideLayout";
    ViewData["PageTitle"] = "Collections";
    ViewData["ActivePage"] = "collections";
}

@section Styles {
    <link rel="stylesheet" href="~/css/collections.css?v=14"/>
}

@section Scripts {
    <script src="~/js/collection_sample.js?v=15"></script>
    <script src="~/js/collections/oc-modal.js?v=1"></script>
    <script src="~/js/collections/remittance.js?v=2"></script>
    <script src="~/js/collections/collection-report.js?v=1"></script>
    <script src="~/js/collections/collection-monitoring.js?v=2"></script>
    <script src="~/js/collections/batch-payments.js?v=1"></script>
    <script src="~/js/collections/my-collection.js?v=1"></script>
    <script src="~/js/collections/invoice-search.js?v=1"></script>
    <script src="~/js/collections/reprint-invoice.js?v=1"></script>
    <script src="~/js/collections/cancel-invoice.js?v=1"></script>
    <script src="~/js/collections/ledger-modal.js?v=2"></script>
    <script src="~/js/collections.js?v=15"></script>
}

<div class="page">

  <!-- ===== Top bar: Teller widget + Scanner ===== -->
  <div class="top-bar">
    <div class="top-bar-right">
      <button class="btn btn-scanner" id="scannerBtn" title="Connect physical scanner">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M3 7V5a2 2 0 0 1 2-2h2"/>
          <path d="M17 3h2a2 2 0 0 1 2 2v2"/>
          <path d="M21 17v2a2 2 0 0 1-2 2h-2"/>
          <path d="M7 21H5a2 2 0 0 1-2-2v-2"/>
          <line x1="7" y1="12" x2="7" y2="12"/>
          <line x1="11" y1="12" x2="17" y2="12"/>
        </svg>
        Scanner
        <span class="scanner-status-dot" id="scannerDot"></span>
      </button>

      <div class="teller-widget" id="tellerWidget">
        <div class="teller-avatar" id="tellerAvatar">EP</div>
        <div class="teller-info">
          <div class="teller-meta-row">
            <div class="teller-meta">
              <span class="teller-meta-label">Teller / Collector</span>
              <div class="teller-select-wrap">
                <select id="tellerName" class="teller-name-select">
                  <!-- populated by initTellerWidget() from SAMPLE_TELLERS -->
                </select>
                <svg class="teller-select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
              </div>
            </div>
            <div class="teller-meta">
              <span class="teller-meta-label">Date</span>
              <div class="teller-date-wrap">
                <input type="date" id="tellerDate" class="teller-date-input" />
                <svg class="teller-date-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
              </div>
            </div>
            <div class="teller-meta teller-meta--cash">
              <span class="teller-meta-label">Cash On-Hand</span>
              <div class="teller-cash-input-wrap">
                <span class="teller-cash-prefix">₱</span>
                <input type="text" id="tellerCash" class="teller-cash-input" value="0.00" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== Search / control card ===== -->
  <div class="search-control-card">
    <div class="search-row">
      <div class="search-box">
        <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        <input id="searchInput" type="text" placeholder="Search by account name or number" autocomplete="off">
        <div class="search-suggestions" id="searchSuggestions" style="display: none;"></div>
      </div>
      <button class="btn btn-reset" id="resetBtn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
        Reset
      </button>

      <div class="multiple-toggle">
        <button class="btn btn-toggle" id="multipleToggle">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
            <rect x="3" y="3" width="5" height="5"/>
            <rect x="14" y="3" width="5" height="5"/>
            <rect x="3" y="14" width="5" height="5"/>
            <rect x="14" y="14" width="5" height="5"/>
          </svg>
          Multiple Accounts
        </button>
      </div>

      <div class="invoice-cluster">
        <span class="invoice-label">Invoice No.</span>
        <div class="invoice-input-group">
          <span class="invoice-prefix">CR00</span>
          <input type="text" class="invoice-input" id="invoiceInput" maxlength="10" />
        </div>
        <span class="acct-count-pill" id="acctCountPill">
          <span class="count-dot" id="acctCountNum">—</span>
          <span id="acctCountLabel">ACCOUNT</span>
        </span>
      </div>
    </div>
  </div>

  <!-- ===== Nav Actions Bar ===== -->
  <div class="nav-actions-bar">
    <a class="nav-item" id="dcrBtn" href="#">
      <div class="nav-icon nav-icon--blue">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="3" width="16" height="18" rx="1.5"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
      </div>
      <span>DCR</span>
    </a>
    <a class="nav-item" id="collectionReportBtn" href="#">
      <div class="nav-icon nav-icon--red">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
      </div>
      <span>Collection Report</span>
    </a>
    <a class="nav-item" id="collectionMonitoringBtn" href="#">
      <div class="nav-icon nav-icon--green">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>
      </div>
      <span>Collection Monitoring</span>
    </a>
    <a class="nav-item" id="batchPaymentBtn" href="#">
      <div class="nav-icon nav-icon--darkblue">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
      </div>
      <span>Batch Payment</span>
    </a>
    <a class="nav-item" id="myCollectionBtn" href="#">
      <div class="nav-icon nav-icon--cyan">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
      </div>
      <span>My Collection</span>
    </a>
    <a class="nav-item" id="invoiceSearchBtn" href="#">
      <div class="nav-icon nav-icon--teal">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      </div>
      <span>Invoice Search</span>
    </a>
    <a class="nav-item" id="reprintInvoiceBtn" href="#">
      <div class="nav-icon nav-icon--orange">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
      </div>
      <span>Reprint Invoice</span>
    </a>
    <a class="nav-item" id="cancelInvoiceBtn" href="#">
      <div class="nav-icon nav-icon--danger">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6M9 9l6 6"/></svg>
      </div>
      <span>Cancel Invoice</span>
    </a>
  </div>

  <!-- ===== Main layout: content grid ===== -->
  <div class="main-layout">

    <!-- ===== Main grid ===== -->
    <div class="grid">

      <!-- LEFT COLUMN -->
      <div>
        <div class="card">
          <div class="card-header">
          <h2>Account Details</h2>
          <span class="badge" id="statusBadge">—</span>
        </div>
        <div class="card-body">
          <div class="field-grid">
            <div class="field">
              <label>Account Number</label>
              <div class="val mono" id="fAccNo">—</div>
            </div>
            <div class="field">
              <label>Meter Number</label>
              <div class="val mono" id="fMeter">—</div>
            </div>
            <div class="field span2">
              <label>Account Name</label>
              <div class="val" id="fName">—</div>
            </div>
            <div class="field span2">
              <label>Address</label>
              <div class="val" id="fAddress">—</div>
            </div>
            <div class="field">
              <label>Type</label>
              <div class="val" id="fType">—</div>
            </div>
            <div class="field oc-field">
              <label>Other Charges Balance</label>
              <div class="val mono" id="fOtherCharges">₱0.00</div>
              <button class="oc-info-btn" id="ocInfoBtn" type="button" aria-label="Add other charges" title="Add other charges">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="16" height="16" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="M12 8v8M8 12h8"/>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>


      <!-- Multiple Accounts Breakdown (only visible in multiple mode) -->
      <div class="multiple-accounts-list" id="multipleAccountsList" style="display: none;">
        <!-- Account breakdown table rendered by collections.js -->
      </div>

      <div class="card" style="margin-top:18px;">
        <div id="tab-bills">
          <table>
            <thead>
              <tr>
                <th style="width:36px;"></th>
                <th>Bill Month</th>
                <th>Due Date</th>
                <th>Amount</th>
                <th>PCA/MMF</th>
                <th>Penalty</th>
                <th style="text-align:right;">Sub Total</th>
              </tr>
            </thead>
            <tbody id="billsBody">
              <!-- Rows are rendered by collections.js from COLLECTION_SAMPLE.bills -->
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN : receipt / payment card -->
    <div>
      <div class="receipt">
        <div class="receipt-inner">

          <div class="receipt-title">
            <div>
              <div class="label-sm" id="totalBalanceLabel">Total Balance</div>
              <div class="amt mono" id="totalBalance">₱0.00</div>
            </div>
            <div class="receipt-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
            </div>
          </div>

          <div class="link-row">
            <button class="link-chip link-chip--conversion" data-modal="conversion">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M17 3v6M17 3l4 4M17 3l-4 4"/><path d="M7 21v-6M7 21l-4-4M7 21l4-4"/></svg>
              Conversion
            </button>
            <button class="link-chip link-chip--discount" data-modal="discount">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><circle cx="8" cy="8" r="2.2"/><circle cx="16" cy="16" r="2.2"/><path d="M18 6L6 18"/></svg>
              Discount
            </button>
            <button class="link-chip link-chip--ledger" data-modal="ledger">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><rect x="4" y="3" width="16" height="18" rx="1.5"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
              Ledger
            </button>
            <button class="link-chip link-chip--others" data-modal="others">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 5v14M5 12h14"/></svg>
              Other Charges
            </button>
          </div>

          <div class="lines">
            <div class="line"><span>Total Bill</span><span class="mono" id="sTotalBill">₱0.00</span></div>
            <div class="line" id="sPCALine"><span>Power Cost Adjustment</span><span class="mono" id="sPCA">₱0.00</span></div>
            <div class="line" id="sMMFLine"><span>Meter Maintenance</span><span class="mono" id="sMMF">₱0.00</span></div>
            <div class="line strong"><span>Total Due</span><span class="mono" id="sTotalDue">₱0.00</span></div>
            <div class="line"><span>Penalty</span><span class="mono" id="sPenalty">₱0.00</span></div>
            <div class="line line--discount" id="sDiscountLine" style="display:none;">
              <span class="discount-label">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-right:4px;vertical-align:-1px;"><circle cx="8" cy="8" r="2.2"/><circle cx="16" cy="16" r="2.2"/><path d="M18 6L6 18"/></svg>
                Senior Citizen Discount
                <button class="discount-remove-btn" id="sDiscountRemoveBtn" title="Remove discount" aria-label="Remove discount">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8"><path d="M18 6L6 18M6 6l12 12"/></svg>
                </button>
              </span>
              <span class="mono" id="sDiscount">-₱0.00</span>
            </div>
          </div>

          <div class="subtotal-bar">
            <span>Sub-Total</span>
            <span class="mono" id="sSubTotal">₱0.00</span>
          </div>

          <div class="section-label">Payment Method</div>
          <div class="pay-options" id="payOptions">
            <div class="pay-opt" data-mode="cash">Cash</div>
            <div class="pay-opt" data-mode="check">Check</div>
            <div class="pay-opt" data-mode="online">Online</div>
          </div>

          <!-- Check Payment Details (shown only when Check is selected) -->
          <div class="check-panel" id="checkPanel" style="display:none;">
            <div class="check-panel-title">Check Payment</div>
            <div class="check-field">
              <label>Bank</label>
              <div class="check-select-wrap">
                <select id="checkBank">
                  <option value="">— Select Bank —</option>
                  <option>BDO Unibank</option>
                  <option>Bank of the Philippine Islands (BPI)</option>
                  <option>Metrobank</option>
                  <option>Land Bank of the Philippines</option>
                  <option>Philippine National Bank (PNB)</option>
                  <option>Security Bank</option>
                  <option>UnionBank</option>
                  <option>Rizal Commercial Banking Corp (RCBC)</option>
                  <option>Eastwest Bank</option>
                  <option>Other</option>
                </select>
                <svg class="check-select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
              </div>
            </div>
            <div class="check-field">
              <label>Branch</label>
              <input type="text" id="checkBranch" placeholder=" " autocomplete="off" />
            </div>
            <div class="check-field">
              <label>Check Number</label>
              <input type="text" id="checkNumber" placeholder=" " autocomplete="off" maxlength="20" />
            </div>
            <div class="check-field">
              <label>Check Date</label>
              <div class="check-date-wrap">
                <input type="date" id="checkDate" />
                <svg class="check-date-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
              </div>
            </div>
          </div>

          <!-- Online Payment Details (shown only when Online is selected) -->
          <div class="check-panel" id="onlinePanel" style="display:none;">
            <div class="check-panel-title">Online Payment</div>
            <div class="check-field">
              <label>Payment Channel</label>
              <div class="check-select-wrap">
                <select id="onlineChannel">
                  <option value="">— Select Channel —</option>
                  <option>GCash</option>
                  <option>Maya (PayMaya)</option>
                  <option>BDO Online Banking</option>
                  <option>BPI Online Banking</option>
                  <option>Metrobank Online</option>
                  <option>UnionBank Online</option>
                  <option>Land Bank iAccess</option>
                  <option>ShopeePay</option>
                  <option>WeChat Pay</option>
                  <option>Other</option>
                </select>
                <svg class="check-select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
              </div>
            </div>
            <div class="check-field">
              <label>Reference Number</label>
              <input type="text" id="onlineRef" placeholder=" " autocomplete="off" maxlength="30" />
            </div>
            <div class="check-field">
              <label>Transaction Date</label>
              <div class="check-date-wrap">
                <input type="date" id="onlineDate" />
                <svg class="check-date-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
              </div>
            </div>
          </div>

          <div class="amt-box">
            <label>Amount to Pay</label>
            <div class="amt-input">
              <span class="cur">₱</span>
              <input type="text" id="amountToPay" value="0.00" readonly>
            </div>
          </div>
          <div class="amt-box">
            <label>Amount Tendered</label>
            <div class="amt-input">
              <span class="cur">₱</span>
              <input type="text" id="amountTendered" value="">
            </div>
          </div>

          <div class="remaining-row" id="remainingRow">
            <span id="remainingLabel">Change</span>
            <span class="mono" id="remainingVal">₱0.00</span>
          </div>

          <div class="action-row">
            <button class="btn btn-primary" id="payBtn">Pay</button>
            <div class="btn-row2">
              <button class="btn btn-secondary" id="reprintBtn">Reprint Invoice</button>
              <button class="btn btn-danger" id="cancelBtn">Cancel Invoice</button>
            </div>
          </div>

        </div>
      </div>
    </div>

  </div>
  <!-- END of grid -->

  </div>
  <!-- END of main-layout -->

</div>
<!-- END of page -->

<!-- ===== Collection Remittance Modal ===== -->
<div class="cr-overlay" id="crOverlay" style="display:none;" aria-modal="true" role="dialog" aria-labelledby="crModalTitle">
  <div class="cr-modal">

    <!-- Header -->
    <div class="cr-header">
      <div class="cr-header-left">
        <h2 class="cr-title" id="crModalTitle">Collection Remittance</h2>

      </div>
      <button class="cr-close" id="crCloseBtn" aria-label="Close modal">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" width="18" height="18">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Row 1: Date + Collector -->
    <div class="cr-row cr-row--2col">
      <div class="cr-field">
        <label class="cr-label" for="crDate">Date</label>
        <input type="date" class="cr-input" id="crDate" />
      </div>
      <div class="cr-field">
        <label class="cr-label" for="crCollector">Collector</label>
        <div class="cr-select-wrap">
          <select class="cr-select" id="crCollector">
            <!-- populated from SAMPLE_COLLECTORS in remittance.js -->
          </select>
          <svg class="cr-select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14">
            <path d="M6 9l6 6 6-6"/>
          </svg>
        </div>
      </div>
    </div>

    <!-- Row 2: OR Start + OR End -->
    <div class="cr-row cr-row--2col">
      <div class="cr-field">
        <label class="cr-label" for="orStart">O.R. Start <span class="cr-required">*</span></label>
        <input type="text" class="cr-input" id="orStart" placeholder="e.g. 001000" autocomplete="off" required />
      </div>
      <div class="cr-field">
        <label class="cr-label" for="orEnd">O.R. End <span class="cr-required">*</span></label>
        <div class="cr-input-with-btn">
          <input type="text" class="cr-input" id="orEnd" placeholder="e.g. 001099" autocomplete="off" required />
          <button class="cr-icon-btn" id="orRefreshBtn" title="Reset O.R. range" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" width="14" height="14">
              <path d="M3 12a9 9 0 1 0 3-6.7"/>
              <path d="M3 4v5h5"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Cash Counter section -->
    <div class="cr-section-label">Cash Counter</div>

    <div class="cr-body">

      <!-- Column A: Denomination table -->
      <div class="cr-col-a">
        <table class="cr-denom-table">
          <colgroup>
            <col class="col-denom" />
            <col class="col-count" />
            <col class="col-amount" />
          </colgroup>
          <thead>
            <tr>
              <th>Denomination</th>
              <th class="cr-th-count">Count</th>
              <th class="cr-th-amount">Amount</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="cr-denom-label">1,000</td>
              <td class="cr-count-cell"><input type="text" inputmode="numeric" class="cr-count-input" id="count-1000" value="" placeholder="0" autocomplete="off" /></td>
              <td class="cr-amount-cell" id="amount-1000">0.00</td>
            </tr>
            <tr>
              <td class="cr-denom-label">500</td>
              <td class="cr-count-cell"><input type="text" inputmode="numeric" class="cr-count-input" id="count-500" value="" placeholder="0" autocomplete="off" /></td>
              <td class="cr-amount-cell" id="amount-500">0.00</td>
            </tr>
            <tr>
              <td class="cr-denom-label">200</td>
              <td class="cr-count-cell"><input type="text" inputmode="numeric" class="cr-count-input" id="count-200" value="" placeholder="0" autocomplete="off" /></td>
              <td class="cr-amount-cell" id="amount-200">0.00</td>
            </tr>
            <tr>
              <td class="cr-denom-label">100</td>
              <td class="cr-count-cell"><input type="text" inputmode="numeric" class="cr-count-input" id="count-100" value="" placeholder="0" autocomplete="off" /></td>
              <td class="cr-amount-cell" id="amount-100">0.00</td>
            </tr>
            <tr>
              <td class="cr-denom-label">50</td>
              <td class="cr-count-cell"><input type="text" inputmode="numeric" class="cr-count-input" id="count-50" value="" placeholder="0" autocomplete="off" /></td>
              <td class="cr-amount-cell" id="amount-50">0.00</td>
            </tr>
            <tr>
              <td class="cr-denom-label">20</td>
