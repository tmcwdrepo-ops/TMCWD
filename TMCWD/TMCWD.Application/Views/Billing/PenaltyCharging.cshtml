@{
    Layout = "_InsideLayout";
    ViewData["PageTitle"] = "Penalty Charging";
    ViewData["ActivePage"] = "penalty-charging";
}

@section Styles {
    <link rel="stylesheet" href="~/css/penalty-charging.css" />
}

<div class="pc-page">

    <!-- ============ TABLE CARD (toolbar + search + table) ============ -->
    <section class="pc-tablecard">

        <!-- Row 1: toolbar -->
        <div class="pc-tablecard-toolbar" aria-label="Penalty run controls">

            <div class="pc-field">
                <label for="pcBillingPeriod">Billing period</label>
                <div class="pc-input-with-icon">
                    <svg viewBox="0 0 24 24" class="pc-input-icon" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    <input type="date" id="pcBillingPeriod" name="billingPeriod" class="pc-input pc-input--with-icon" />
                </div>
            </div>

            <div class="pc-field">
                <label for="pcPostingDate">Posting date</label>
                <div class="pc-input-with-icon">
                    <svg viewBox="0 0 24 24" class="pc-input-icon" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    <input type="date" id="pcPostingDate" name="postingDate" class="pc-input pc-input--with-icon" />
                </div>
            </div>

            <button type="button" id="pcLoadBtn" class="pc-btn pc-btn--success">
                <svg viewBox="0 0 20 20" class="pc-icon" aria-hidden="true">
                    <path d="M10 3a7 7 0 1 0 6.32 4H14.9A5.5 5.5 0 1 1 10 4.5V7l4-3-4-3v2z" fill="currentColor" />
                </svg>
                Load entries
            </button>

            <div class="pc-toolbar-spacer"></div>

            <button type="button" id="pcResetBtn" class="pc-btn pc-btn--muted">Reset</button>
            <button type="button" id="pcPostBtn" class="pc-btn pc-btn--primary" disabled>
                Post penalties
            </button>
        </div>

        <!-- Row 2: search + selection count -->
        <div class="pc-tablecard-head">
            <div class="pc-search-area">
                <div class="pc-search">
                    <svg viewBox="0 0 20 20" class="pc-icon" aria-hidden="true">
                        <path d="M13.5 12.4h-.8l-.3-.3a6.4 6.4 0 1 0-.7.7l.3.3v.8l4.9 4.9 1.5-1.5-4.9-4.9zm-5.9 0a4.4 4.4 0 1 1 0-8.9 4.4 4.4 0 0 1 0 8.9z" fill="currentColor" />
                    </svg>
                    <input type="search"
                           id="pcSearch"
                           class="pc-search-input"
                           placeholder="Search account no. or name"
                           autocomplete="off" />
                </div>

                <div class="pc-charge-counter">
                    <span class="pc-charge-label">Account(s) to charge:</span>
                    <span class="pc-charge-count" id="pcChargeCount">0</span>
                </div>
            </div>

            <div class="pc-tablecard-meta">
                <span id="pcSelectedCount">0</span> of <span id="pcVisibleCount">0</span> selected
            </div>
        </div>

        <div class="pc-table-scroll">
            <table class="pc-table" id="pcTable">
                <thead>
                    <tr>
                        <th scope="col">Account no.</th>
                        <th scope="col" class="pc-center">Usage</th>
                        <th scope="col" class="pc-num">Bill amount</th>
                        <th scope="col" class="pc-num">Discount</th>
                        <th scope="col" class="pc-num">Penalty</th>
                        <th scope="col" class="pc-check-col">
                            <input type="checkbox" id="pcSelectAll" aria-label="Select all accounts" disabled />
                        </th>
                    </tr>
                </thead>

                <tbody id="pcTableBody">
                    <tr class="pc-empty-row">
                        <td colspan="6">
                            <div class="pc-empty-state">
                                <svg viewBox="0 0 48 48" class="pc-empty-icon" aria-hidden="true">
                                    <path d="M24 4 4 14v10c0 11 8.5 17.4 20 20 11.5-2.6 20-9 20-20V14L24 4z"
                                          fill="none" stroke="currentColor" stroke-width="2" />
                                    <path d="M24 22v10M24 16h.01" stroke="currentColor" stroke-width="2.4"
                                          stroke-linecap="round" />
                                </svg>
                                <p>Select a billing period and load entries to review penalty charges.</p>
                            </div>
                        </td>
                    </tr>
                </tbody>

                <tfoot>
                    <tr>
                        <td colspan="2">Totals</td>
                        <td class="pc-num" id="pcTotalBill">&mdash;</td>
                        <td class="pc-num" id="pcTotalDiscount">&mdash;</td>
                        <td class="pc-num" id="pcTotalPenalty">&mdash;</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- Pagination -->
        <div class="pagination" id="pcPagination" aria-label="Table pagination">
            <span class="pagination__summary" id="pcPaginationSummary">Showing 1-15 of 15 accounts</span>
            <div class="pagination__controls" id="pcPaginationControls">
                <button class="pagination__btn" type="button" id="pcPrevPageBtn" aria-label="Previous page" disabled>
                    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    Prev
                </button>
                <!-- Page number buttons rendered by JS -->
                <button class="pagination__btn" type="button" id="pcNextPageBtn" aria-label="Next page">
                    Next
                    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path d="M6 12l4-4-4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
            </div>
        </div>
    </section>
</div>

<!-- ============ CONFIRM POST MODAL ============ -->
<div class="pc-modal-backdrop" id="pcConfirmModal" hidden>
    <div class="pc-modal" role="alertdialog" aria-modal="true" aria-labelledby="pcConfirmTitle">
        <h2 id="pcConfirmTitle">Post penalty charges?</h2>
        <p>
            This will charge penalties to <strong id="pcConfirmCount">0</strong> account(s)
            totaling <strong id="pcConfirmTotal">&#8369;0.00</strong> for
            <strong id="pcConfirmPeriod">&mdash;</strong>. This action cannot be undone.
        </p>
        <div class="pc-modal-actions">
            <button type="button" class="pc-btn pc-btn--muted" id="pcConfirmCancel">Cancel</button>
            <button type="button" class="pc-btn pc-btn--primary" id="pcConfirmOk">Yes, post charges</button>
        </div>
    </div>
</div>

<!-- ============ SUCCESS MODAL ============ -->
<div class="pc-modal-backdrop" id="pcSuccessModal" hidden>
    <div class="pc-modal pc-modal--success" role="alertdialog" aria-modal="true" aria-labelledby="pcSuccessTitle">
        <div class="pc-success-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22,4 12,14.01 9,11.01"/>
            </svg>
        </div>
        <h2 id="pcSuccessTitle">Penalties posted successfully!</h2>
        <p>
            Successfully charged penalties to <strong id="pcSuccessCount">0</strong> account(s)
            totaling <strong id="pcSuccessTotal">&#8369;0.00</strong> for
            <strong id="pcSuccessPeriod">&mdash;</strong>.
        </p>
        <div class="pc-modal-actions">
            <button type="button" class="pc-btn pc-btn--primary" id="pcSuccessOk">Continue</button>
        </div>
    </div>
</div>

<!-- ============ TOAST ============ -->
<div class="pc-toast" id="pcToast" role="status" aria-live="polite"></div>

@section Scripts {
    <script src="~/js/penalty-charging-sample.js"></script>
    <script src="~/js/penalty-charging.js"></script>
}
