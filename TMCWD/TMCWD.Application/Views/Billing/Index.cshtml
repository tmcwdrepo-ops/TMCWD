@{
    Layout = "_insideLayout";
    ViewData["PageTitle"] = "View Reading Sheet Created";
    ViewData["ActivePage"] = "reading-sheet";
}

@section Styles {
  <link rel="stylesheet" href="~/css/reading-sheet.css"/>
  <link rel="stylesheet" href="~/css/create_reading.css"/>
}

@section Scripts {
  <script src="~/js/reading-sheet-sample.js"></script>
  <script src="~/js/reading-sheet.js"></script>
  <script src="~/js/create_reading.js"></script>
  <script>
    // Wait for DOM to be fully ready before initializing
    document.addEventListener('DOMContentLoaded', async function() {
      
      // const meterReaders = await fetch('@Url.Action("GetUsersByRole", "Admin")' + '?role=4', {
      //     method: 'GET',
      //     headers: {
      //         'Content-Type': 'application/json'
      //     }
      // }).then(response => {
      //     if(!response.ok || response.status == 204)
      //       return null;
      //     return response.json();
      // }).then(result => {
      //     return result;
      // });

      // console.log('Meter Readers:', meterReaders);

      // Initialize the reading sheet page
      if (typeof initReadingSheetPage === 'function') {
        initReadingSheetPage();
      }

      var createNewBtn = document.getElementById('createNewBtn');
      if (createNewBtn) {
        createNewBtn.addEventListener('click', function () {
          if (typeof openCreateModal === 'function') openCreateModal();
        });
      }

      const crBillingDate = document.getElementById('crBillingDate');
      console.log('crBillingDate:', crBillingDate);
      if (crBillingDate){
          var dateToday = new Date();
          crBillingDate.min = dateToday.toISOString().split("T")[0];
          crBillingDate.value = dateToday.toISOString().split("T")[0];
          crBillingDate.addEventListener('change', (evt) => {
              console.log('Billing Date was changed');
              const crDueDate = document.getElementById('crDueDate');
              const billingDate = new Date(evt.target.value);
              console.log('New Billing Date:', billingDate);
              if(crDueDate){
                var minDueDate = new Date();
                minDueDate.setDate(billingDate.getDate() + 1);
                crDueDate.min = minDueDate.toISOString().split("T")[0];
                crDueDate.addEventListener('change', (evt) => {
                    const crDisconnectionDate = document.getElementById('crDisconnectionDate');
                    if (crDisconnectionDate){
                        const dueDate = new Date(evt.target.value);
                        var minDisconnectionDate = new Date();
                        minDisconnectionDate.setDate(dueDate.getDate() + 1);
                        crDisconnectionDate.min = minDisconnectionDate.toISOString().split("T")[0];
                    }
                });
              }
              const crBillingPeriodStart = document.getElementById('crBillingPeriodStart');
              if (crBillingPeriodStart){
                  crBillingPeriodStart.value = crBillingDate.value;
                  crBillingPeriodStart.min = crBillingDate.min;
              }
          });
      }

      const crScope = document.getElementById('crScope');
      if(crScope){
          crScope.addEventListener('change', (evt) => {
              const selectedValue = evt.target.value;
              const crScopeRange = document.getElementById('crScopeRange');
              if(crScopeRange){
                if(selectedValue === 'ranged'){  
                    crScopeRange.style.display = 'grid';
                }
                else{
                    crScopeRange.style.display = 'none';
                }
              }
          });
      }

      var crSaveBtnEl = document.getElementById('crSaveBtn');
      if (crSaveBtnEl) {
        crSaveBtnEl.addEventListener('click', function () {
          var data = {
            billingDate:        (document.getElementById('crBillingDate')        || {}).value || '',
            dueDate:            (document.getElementById('crDueDate')            || {}).value || '',
            disconnectionDate:  (document.getElementById('crDisconnectionDate') || {}).value || '',
            billingPeriodStart: (document.getElementById('crBillingPeriodStart') || {}).value || '',
            meterReader:        (document.getElementById('crMeterReaderInput')  || {}).value || '',
            zone:               (document.getElementById('crZone')              || {}).value || '',
            book:               (document.getElementById('crBook')              || {}).value || '',
            scope:              (document.getElementById('crScope')             || {}).value || ''
          };
          if (typeof onReadingSheetCreated === 'function') onReadingSheetCreated(data);
          document.dispatchEvent(new CustomEvent('readingSheet:created', { detail: data }));
        });
      }
    });

  </script>
}

<section class="page-section" aria-label="View Reading Sheet Created">

  <!-- Toolbar -->
  <div class="page-toolbar">
    <div class="page-toolbar__left">
      <button class="btn btn--green" type="button" id="createNewBtn">
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        Create New
      </button>
      <div class="search-input-wrap">
        <svg class="search-input__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="6.5" cy="6.5" r="4" stroke="currentColor" stroke-width="1.4"/>
          <path d="M11 11l2.5 2.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
        <input
          class="search-input"
          type="search"
          placeholder="Search..."
          aria-label="Search reading sheets"
          autocomplete="off"
        />
      </div>
    </div>
    <div class="page-toolbar__right">
      <label class="status-toggle" aria-label="Show active only">
        <input class="status-toggle__input" type="checkbox" role="switch" aria-checked="false" />
        <span class="status-toggle__track" aria-hidden="true">
          <span class="status-toggle__thumb"></span>
        </span>
        <span class="status-toggle__label">Show Completed</span>
      </label>
    </div>
  </div>

  <!-- Bulk Actions Bar (hidden until rows are selected) -->
  <div class="bulk-bar" id="bulkActionsBar" hidden>
    <span class="bulk-bar__count" id="bulkSelectedCount">0 selected</span>
    <div class="bulk-bar__actions">
      <button class="btn btn--danger" type="button" id="bulkDeleteBtn">
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 4h12M5 4V2h6v2M6 7v5M10 7v5M3 4l1 9h8l1-9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Delete Selected
      </button>
      <button class="btn btn--ghost" type="button" id="bulkClearBtn">
        Clear selection
      </button>
    </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <div class="modal-backdrop" id="deleteModalBackdrop" hidden aria-hidden="true">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle">
      <div class="modal__icon modal__icon--danger" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M10 11v5M14 11v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </div>
      <h2 class="modal__title" id="deleteModalTitle">Delete Record</h2>
      <p class="modal__body">Are you sure you want to delete this record? This action cannot be undone.</p>
      <div class="modal__actions">
        <button class="btn btn--ghost" type="button" id="deleteModalCancel">Cancel</button>
        <button class="btn btn--danger" type="button" id="deleteModalConfirm">Delete</button>
      </div>
    </div>
  </div>

  <!-- Edit Record Modal -->
  <div class="modal-backdrop" id="editModalBackdrop" hidden aria-hidden="true">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="editModalTitle" style="max-width: 500px;">
      <h2 class="modal__title" id="editModalTitle">Edit Reading Sheet</h2>
      <div class="modal__body" style="width: 100%; max-width: 100%; text-align: left;">
        <input type="hidden" id="editRowId" />
        <div style="display: flex; flex-direction: column; gap: 14px;">
          <div style="display: flex; flex-direction: column; gap: 6px;">
            <label for="editMeterReader" style="font-size: 13px; font-weight: 600; color: var(--color-text-dim);">Meter Reader</label>
            <input type="text" id="editMeterReader" style="width: 100%; padding: 8px 12px; border: 1px solid var(--color-border); border-radius: 6px; background: var(--color-panel-alt); color: var(--color-text); font-size: 14px; font-family: var(--font-sans);" />
          </div>
          <div style="display: flex; flex-direction: column; gap: 6px;">
            <label for="editBillingDate" style="font-size: 13px; font-weight: 600; color: var(--color-text-dim);">Billing Date</label>
            <input type="date" id="editBillingDate" style="width: 100%; padding: 8px 12px; border: 1px solid var(--color-border); border-radius: 6px; background: var(--color-panel-alt); color: var(--color-text); font-size: 14px; font-family: var(--font-sans);" />
          </div>
          <div style="display: flex; flex-direction: column; gap: 6px;">
            <label for="editZone" style="font-size: 13px; font-weight: 600; color: var(--color-text-dim);">Zone</label>
            <input type="text" id="editZone" style="width: 100%; padding: 8px 12px; border: 1px solid var(--color-border); border-radius: 6px; background: var(--color-panel-alt); color: var(--color-text); font-size: 14px; font-family: var(--font-sans);" />
          </div>
          <div style="display: flex; flex-direction: column; gap: 6px;">
            <label for="editForPosting" style="font-size: 13px; font-weight: 600; color: var(--color-text-dim);">For Posting</label>
            <input type="number" id="editForPosting" style="width: 100%; padding: 8px 12px; border: 1px solid var(--color-border); border-radius: 6px; background: var(--color-panel-alt); color: var(--color-text); font-size: 14px; font-family: var(--font-sans);" />
          </div>
          <div style="display: flex; flex-direction: column; gap: 6px;">
            <label for="editStatus" style="font-size: 13px; font-weight: 600; color: var(--color-text-dim);">Status</label>
            <select id="editStatus" style="width: 100%; padding: 8px 12px; border: 1px solid var(--color-border); border-radius: 6px; background: var(--color-panel-alt); color: var(--color-text); font-size: 14px; font-family: var(--font-sans);">
              <option value="In-Progress">In Progress</option>
              <option value="Completed">Completed</option>
            </select>
          </div>
        </div>
      </div>
      <div class="modal__actions">
        <button class="btn btn--ghost" type="button" id="editModalCancel">Cancel</button>
        <button class="btn btn--green" type="button" id="editModalSave">Save Changes</button>
      </div>
    </div>
  </div>

  <!-- Bulk Delete Confirmation Modal -->
  <div class="modal-backdrop" id="bulkDeleteModalBackdrop" hidden aria-hidden="true">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="bulkDeleteModalTitle">
      <div class="modal__icon modal__icon--danger" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M10 11v5M14 11v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </div>
      <h2 class="modal__title" id="bulkDeleteModalTitle">Delete Selected Records</h2>
      <p class="modal__body" id="bulkDeleteModalBody">You are about to delete <strong id="bulkDeleteCount">0</strong> record(s). This cannot be undone.</p>
      <p class="modal__body">Type <strong>delete all</strong> to confirm.</p>
      <input
        class="modal__confirm-input"
        type="text"
        id="bulkDeleteConfirmInput"
        placeholder="delete all"
        aria-label="Type delete all to confirm"
        autocomplete="off"
        spellcheck="false"
      />
      <div class="modal__actions">
        <button class="btn btn--ghost" type="button" id="bulkDeleteModalCancel">Cancel</button>
        <button class="btn btn--danger" type="button" id="bulkDeleteModalConfirm" disabled>Delete All</button>
      </div>
    </div>
  </div>

  <!-- Table panel -->
  <div class="panel">
    <div class="table-wrap">
      <table class="data-table" id="readingSheetTable" aria-label="Reading sheets">
        <thead>
          <tr>
            <th class="col-check" scope="col">
              <input class="tbl-checkbox" type="checkbox" id="selectAllRows" aria-label="Select all rows" />
            </th>
            <th scope="col">
              <span class="th-inner" data-sort="meterReader">
                Meter Reader
                <svg class="sort-icon" viewBox="0 0 10 14" fill="none" aria-hidden="true">
                  <path d="M5 1v12M1 4l4-3 4 3M1 10l4 3 4-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </th>
            <th scope="col">
              <span class="th-inner" data-sort="billingDate">
                Billing Date
                <svg class="sort-icon" viewBox="0 0 10 14" fill="none" aria-hidden="true">
                  <path d="M5 1v12M1 4l4-3 4 3M1 10l4 3 4-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </th>
            <th scope="col">
              <span class="th-inner" data-sort="zone">
                Zone
                <svg class="sort-icon" viewBox="0 0 10 14" fill="none" aria-hidden="true">
                  <path d="M5 1v12M1 4l4-3 4 3M1 10l4 3 4-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </th>
            <th scope="col">
              <span class="th-inner" data-sort="forPosting">
                For Posting
                <svg class="sort-icon" viewBox="0 0 10 14" fill="none" aria-hidden="true">
                  <path d="M5 1v12M1 4l4-3 4 3M1 10l4 3 4-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </th>
            <th scope="col">
              <span class="th-inner">
                Status
              </span>
            </th>
            <th scope="col" class="col-actions">Actions</th>
          </tr>
        </thead>
        <tbody id="readingSheetBody">
          <!-- Rows are rendered by initReadingSheetPage() in scripts/reading-sheet.js -->
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="pagination" id="readingSheetPagination" aria-label="Table pagination">
      <span class="pagination__summary" id="paginationSummary"></span>
      <div class="pagination__controls" id="paginationControls">
        <button class="pagination__btn" type="button" id="prevPageBtn" aria-label="Previous page" disabled>
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Prev
        </button>
        <!-- Page number buttons rendered by JS -->
        <button class="pagination__btn" type="button" id="nextPageBtn" aria-label="Next page">
          Next
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 12l4-4-4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>
  </div>  <!-- ══════════════════════════════════════════
       CREATE READING SHEET — MODAL (Phase 1-8)
  ══════════════════════════════════════════ -->
  <div class="cr-backdrop" id="crBackdrop" hidden aria-hidden="true">
    <div class="cr-modal" role="dialog" aria-modal="true" aria-labelledby="crModalTitle">

      <!-- Header -->
      <div class="cr-header">
        <button class="cr-header__fav" type="button" aria-label="Favourite template">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M10 2l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 14.27l-4.77 2.44.91-5.32L2.27 7.62l5.34-.78L10 2z"
                  stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="cr-header__template-wrap">
          <div class="cr-select-wrap">
            <select id="crTemplateSelect" class="cr-select">
              <option value="">Select Template...</option>
              <option value="tpl_monthly">Monthly Standard</option>
              <option value="tpl_quarterly">Quarterly Round</option>
              <option value="tpl_special">Special Reading</option>
            </select>
            <svg class="cr-select__chevron" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
        <div class="cr-header__templates-wrap">
          <button class="cr-header__templates-btn" type="button" id="crTemplatesMenuBtn">
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <rect x="1" y="1" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
              <rect x="9" y="1" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
              <rect x="1" y="9" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
              <rect x="9" y="9" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
            </svg>
            Templates
          </button>
          <ul class="cr-templates-dropdown" id="crTemplatesDropdown" hidden>
            <li class="cr-templates-dropdown__item" data-tpl="tpl_monthly">
              <svg viewBox="0 0 16 16" fill="none"><rect x="1" y="2" width="14" height="13" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M5 1v2M11 1v2M1 6h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
              Monthly Standard
            </li>
            <li class="cr-templates-dropdown__item" data-tpl="tpl_quarterly">
              <svg viewBox="0 0 16 16" fill="none"><rect x="1" y="2" width="14" height="13" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M5 1v2M11 1v2M1 6h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
              Quarterly Round
            </li>
            <li class="cr-templates-dropdown__item" data-tpl="tpl_special">
              <svg viewBox="0 0 16 16" fill="none"><rect x="1" y="2" width="14" height="13" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M5 1v2M11 1v2M1 6h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
              Special Reading
            </li>
          </ul>
        </div>
        <button class="cr-header__close" type="button" id="crCloseBtn" aria-label="Close modal">
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

      <!-- Body: date fields + meter reader + zone/book/scope -->
      <div class="cr-body">
        <div class="cr-form">

          <div class="cr-row cr-row--2col">
            <div class="cr-field">
              <label class="cr-field__label" for="crBillingDate">Billing Date</label>
              <div class="cr-input-wrap">
                <input class="cr-input" type="date" id="crBillingDate" value="2025-07-01"/>
                <svg class="cr-input__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="1" y="2" width="14" height="13" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M5 1v2M11 1v2M1 6h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
              </div>
            </div>
            <div class="cr-field">
              <label class="cr-field__label" for="crDueDate">Due Date</label>
              <div class="cr-input-wrap">
                <input class="cr-input" type="date" id="crDueDate" value="2025-07-15"/>
                <svg class="cr-input__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="1" y="2" width="14" height="13" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M5 1v2M11 1v2M1 6h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
              </div>
            </div>
          </div>

          <div class="cr-row cr-row--1col">
            <div class="cr-field">
              <label class="cr-field__label" for="crDisconnectionDate">Disconnection Date</label>
              <div class="cr-input-wrap">
                <input class="cr-input" type="date" id="crDisconnectionDate" value="2025-08-01"/>
                <svg class="cr-input__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="1" y="2" width="14" height="13" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M5 1v2M11 1v2M1 6h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
              </div>
            </div>
          </div>

          <div class="cr-row cr-row--2col cr-row--valign">
            <div class="cr-field">
              <label class="cr-field__label" for="crBillingPeriodStart">Billing Period Start</label>
              <div class="cr-input-wrap">
                <input class="cr-input" type="date" id="crBillingPeriodStart" value="2025-07-01" disabled/>
                <svg class="cr-input__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="1" y="2" width="14" height="13" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M5 1v2M11 1v2M1 6h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
              </div>
            </div>
            <div class="cr-field cr-field--checkbox-only">
              <label class="cr-checkbox-label" for="crOverrideStart">
                <input class="cr-checkbox" type="checkbox" id="crOverrideStart"/>
                <span class="cr-checkbox__box" aria-hidden="true"></span>
                Override Start Date
              </label>
            </div>
          </div>

          <div class="cr-row cr-row--1col">
            <div class="cr-field">
              <label class="cr-field__label" for="crMeterReaderInput">Meter Reader</label>
              <div class="cr-combobox" id="crMeterReaderCombobox">
                <div class="cr-input-wrap">
                  <input class="cr-input cr-input--search" type="text" id="crMeterReaderInput"
                         placeholder="Search meter reader..." autocomplete="off"
                         role="combobox" aria-expanded="false" aria-controls="crMeterReaderList" aria-autocomplete="list"/>
                  <svg class="cr-input__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <circle cx="6.5" cy="6.5" r="4" stroke="currentColor" stroke-width="1.4"/>
                    <path d="M11 11l2.5 2.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                  </svg>
                </div>
                <ul class="cr-combobox__list" id="crMeterReaderList" role="listbox" aria-label="Meter readers" hidden></ul>
              </div>
            </div>
          </div>

          <div class="cr-row cr-row--2col">
            <div class="cr-field">
              <label class="cr-field__label" for="crZone">Zone</label>
              <div class="cr-input-wrap">
                <select class="cr-input cr-input--select" id="crZone">
                  <option value="">Select Zone...</option>
                  <option value="zone1">Zone 1</option>
                  <option value="zone2">Zone 2</option>
                  <option value="zone3">Zone 3</option>
                  <option value="zone4">Zone 4</option>
                </select>
                <svg class="cr-input__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
            </div>
            <div class="cr-field">
              <label class="cr-field__label" for="crBook">Book</label>
              <div class="cr-input-wrap">
                <select class="cr-input cr-input--select" id="crBook">
                  <option value="">Select Book...</option>
                  <option value="book1">Book 1</option>
                  <option value="book2">Book 2</option>
                  <option value="book3">Book 3</option>
                  <option value="book4">Book 4</option>
                  <option value="book5">Book 5</option>
                  <option value="book6">Book 6</option>
                </select>
                <svg class="cr-input__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
            </div>
          </div>

          <div class="cr-row cr-row--1col">
            <div class="cr-field">
              <label class="cr-field__label" for="crScope">Scope</label>
              <div class="cr-input-wrap">
                <select class="cr-input cr-input--select" id="crScope">
                  <option value="all">All</option>
                  <option value="unbilled">Unbilled</option>
                  <option value="ranged">Ranged</option>
                </select>
                <svg class="cr-input__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
            </div>
          </div>

          <div style="display: none" class="cr-row cr-row--2col cr-scope-range" id="crScopeRange" hidden>
            <div class="cr-field">
              <label class="cr-field__label" for="crFromSeq">From Sequence</label>
              <div class="cr-input-wrap">
                <input class="cr-input" type="number" id="crFromSeq" min="1" placeholder="e.g. 1"/>
              </div>
            </div>
            <div class="cr-field">
              <label class="cr-field__label" for="crToSeq">To Sequence</label>
              <div class="cr-input-wrap">
                <input class="cr-input" type="number" id="crToSeq" min="1" placeholder="e.g. 100"/>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- Accounts table panel -->
      <div class="cr-table-panel" id="crTablePanel" hidden>
        <div class="cr-table-wrap">
          <table class="cr-table" id="crAccountsTable" aria-label="Accounts">
            <thead>
              <tr>
                <th class="cr-th cr-th--num" scope="col">#</th>
                <th class="cr-th" scope="col">Account No.</th>
                <th class="cr-th" scope="col">Address</th>
                <th class="cr-th" scope="col">Account Type</th>
                <th class="cr-th cr-th--seq" scope="col">Sequence</th>
              </tr>
            </thead>
            <tbody id="crAccountsTbody"></tbody>
          </table>
        </div>
        <p class="cr-table-empty" id="crTableEmpty" hidden>No accounts match the selected filters.</p>
        <div class="cr-pagination" id="crPagination" hidden>
          <span class="cr-pagination__summary" id="crPagSummary"></span>
          <div class="cr-pagination__controls" id="crPagControls">
            <button class="cr-pag-btn" type="button" id="crPrevBtn" disabled>
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 12L6 8l4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Prev
            </button>
            <button class="cr-pag-btn" type="button" id="crNextBtn">
              Next
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 12l4-4-4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Footer -->
      <div class="cr-footer">
        <div class="cr-footer__left" id="crTemplateActions" hidden>
          <button class="cr-btn cr-btn--danger" type="button" id="crDeleteTemplateBtn">Delete Template</button>
          <button class="cr-btn cr-btn--outline" type="button" id="crEditTemplateBtn">Edit Template</button>
        </div>
        <div class="cr-footer__spacer"></div>
        <div class="cr-footer__right">
          <button class="cr-btn cr-btn--outline" type="button" id="crLoadAccountsBtn">
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 2v8M5 7l3 3 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M2 12h12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            Load Accounts
          </button>
          <button class="cr-btn cr-btn--primary" type="button" id="crSaveBtn">
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2 8.5l4 4 8-8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Save
          </button>
        </div>
      </div>

    </div>
  </div>
  <!-- /cr-backdrop -->

  <!-- Toast -->
  <div class="cr-toast" id="crToast" hidden aria-live="polite"></div>

</section>
