@model TMCWD.Application.Models.BillAdjustmentViewModel
@{
    Layout = "_InsideLayout";
    ViewData["PageTitle"] = "Bill Adjustment";
    ViewData["ActivePage"] = "bill-adjustment";
}

@section Styles {
    <link rel="stylesheet" href="~/css/reading-sheet.css" />
    <link rel="stylesheet" href="~/css/create_reading.css" />
}
@section Scripts {
    <script src="~/js/bill_adjustment.js"></script>
}

<section class="page-section" aria-label="Bill Adjustment">

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="margin-bottom:var(--space-md);padding:var(--space-sm) var(--space-md);border-radius:var(--radius-md);background:rgba(34,165,89,0.12);color:#22a559;border:1px solid rgba(34,165,89,0.35);font-size:var(--font-size-sm);font-family:var(--font-sans);">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div style="margin-bottom:var(--space-md);padding:var(--space-sm) var(--space-md);border-radius:var(--radius-md);background:rgba(255,69,58,0.12);color:#ff453a;border:1px solid rgba(255,69,58,0.35);font-size:var(--font-size-sm);font-family:var(--font-sans);">
            @TempData["ErrorMessage"]
        </div>
    }

    <form method="post" asp-action="SubmitAdjustment" asp-controller="Billing">
        @Html.AntiForgeryToken()

        <!-- ── Header fields ── -->
        <div class="panel" style="margin-bottom:var(--space-md);border-radius:var(--radius-md);">
            <div style="padding:var(--space-md);">
                <div class="cr-form">

                    <div class="cr-row cr-row--2col">
                        <div class="cr-field">
                            <label class="cr-field__label" for="AccountNumber">Account Number</label>
                            <div class="cr-combobox" id="accountCombobox">
                                <div class="cr-input-wrap">
                                    <input class="cr-input cr-input--search" id="AccountNumber" name="AccountNumber"
                                           type="text" value="@Model.AccountNumber" placeholder="e.g. 00-0000" autocomplete="off" />
                                </div>
                                <ul class="cr-combobox__list" id="accountList" role="listbox" hidden></ul>
                            </div>
                        </div>

                        <div class="cr-field">
                            <label class="cr-field__label" for="BamDate">BAM Date</label>
                            <div class="cr-input-wrap">
                                <input class="cr-input" id="BamDate" name="BamDate"
                                       type="date" value="@(Model.BamDate?.ToString("yyyy-MM-dd"))" />
                            </div>
                        </div>
                    </div>

                    <div class="cr-row cr-row--2col">
                        <div class="cr-field">
                            <label class="cr-field__label" for="MeterReader">Meter Reader</label>
                            <div class="cr-select-wrap">
                                <select class="cr-input cr-input--select" id="MeterReader" name="MeterReader">
                                    <option value="">— Select —</option>
                                    @foreach (var item in Model.MeterReaders)
                                    {
                                        if (item.Value == Model.MeterReader)
                                        {
                                            <option value="@item.Value" selected>@item.Text</option>
                                        }
                                        else
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    }
                                </select>
                                <svg class="cr-select__chevron" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                    <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </div>
                        </div>
                       <!-- Calendar should be changed to a  new pop out to be populated with the data based on the account number  -->
                        <div class="cr-field">
                            <label class="cr-field__label" for="BillingDate">Billing Date</label>
                            <div class="cr-input-wrap">
                                <input class="cr-input" id="BillingDate" name="BillingDate"
                                       type="date" value="@(Model.BillingDate?.ToString("yyyy-MM-dd"))" />
                            </div>
                        </div>
                    </div>

                    <div class="cr-row cr-row--2col">
                        <div class="cr-field">
                            <label class="cr-field__label" for="Remarks">Remarks</label>
                            <div class="cr-select-wrap">
                                <select class="cr-input cr-input--select" id="Remarks" name="Remarks">
                                    <option value="">— Select —</option>
                                    @foreach (var item in Model.RemarksOptions)
                                    {
                                        if (item.Value == Model.Remarks)
                                        {
                                            <option value="@item.Value" selected>@item.Text</option>
                                        }
                                        else
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    }
                                </select>
                                <svg class="cr-select__chevron" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                                    <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </div>
                        </div>

                        <div class="cr-field">
                            <!-- spacer -->
                        </div>
                    </div>

                    <div class="cr-row cr-row--1col">
                        <div class="cr-field">
                            <label class="cr-field__label" for="Explanation">Explanation</label>
                            <textarea class="cr-input" id="Explanation" name="Explanation"
                                      rows="3" style="height:auto;padding-top:9px;padding-bottom:9px;resize:vertical;"
                                      placeholder="Describe the reason for this adjustment...">@Model.Explanation</textarea>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- ── Adjustment lines table ── -->
        <div class="panel" style="margin-bottom:var(--space-md);border-radius:var(--radius-md);">
            <div class="table-wrap">
                <table class="data-table" aria-label="Adjustment lines">
                    <thead>
                        <tr>
                            <th style="width:2.5rem;"></th>
                            <th>Item</th>
                            <th>As Billed</th>
                            <th>Should Be</th>
                            <th>Adjustment</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.AdjustmentLines.Count; i++)
                        {
                            var line = Model.AdjustmentLines[i];
                            <tr>
                                <td class="col-check">
                                    <input type="hidden" name="AdjustmentLines[@i].Key"   value="@line.Key" />
                                    <input type="hidden" name="AdjustmentLines[@i].Label" value="@line.Label" />
                                    <input type="hidden" name="AdjustmentLines[@i].HasAdjustmentColumn" value="@line.HasAdjustmentColumn.ToString().ToLower()" />
                                    <input class="tbl-checkbox" type="checkbox"
                                           name="AdjustmentLines[@i].IsChecked"
                                           value="true"
                                           @(line.IsChecked ? "checked" : "")
                                           aria-label="Select @line.Label" />
                                </td>
                                <td>@line.Label</td>
                                <td>
                                    <input class="cr-input" type="number" step="0.01"
                                           name="AdjustmentLines[@i].AsBilled"
                                           value="@line.AsBilled" placeholder="0.00"
                                           style="height:32px;font-size:var(--font-size-sm);" />
                                </td>
                                <td>
                                    <input class="cr-input" type="number" step="0.01"
                                           name="AdjustmentLines[@i].ShouldBe"
                                           value="@line.ShouldBe" placeholder="0.00"
                                           style="height:32px;font-size:var(--font-size-sm);" />
                                </td>
                                <td>
                                    @if (line.HasAdjustmentColumn)
                                    {
                                        <input class="cr-input" type="number" step="0.01"
                                               name="AdjustmentLines[@i].Adjustment"
                                               value="@line.Adjustment" placeholder="0.00"
                                               style="height:32px;font-size:var(--font-size-sm);" />
                                    }
                                    else
                                    {
                                        <span style="color:var(--color-text-faint);font-size:var(--font-size-sm);">N/A</span>
                                        <input type="hidden" name="AdjustmentLines[@i].Adjustment" value="" />
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ── Actions ── -->
        <div style="display:flex;gap:var(--space-sm);justify-content:flex-end;">
            <a href="@Url.Action("ReadingSheet", "Billing")" class="btn btn--ghost">Cancel</a>
            <button type="submit" class="btn btn--green">Submit Adjustment</button>
        </div>

    </form>

</section>
