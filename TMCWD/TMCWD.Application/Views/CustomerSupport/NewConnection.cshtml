@model TMCWD.Model.Dashboard.NewConnectionApplicationRecord
@{
    Layout = "_InsideLayout";
    ViewData["PageTitle"] = "New Connection";
    ViewData["ActivePage"] = "new-connection";
}

@section Styles {
    <link rel="stylesheet" href="~/css/new-connection.css" asp-append-version="true" />
}

<section class="nc-page" aria-labelledby="newConnectionTitle">
    @Html.AntiForgeryToken()
    <header class="nc-heading">
        <div>
            <span class="nc-eyebrow">Services</span>
            <h1 id="newConnectionTitle">New Connection Application</h1>
            <p>Create a walk-in water service application and send it to the service-processing dashboard.</p>
        </div>
        <button type="button" class="nc-pdf-button" id="ncPrint" title="Print application">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 2h7l4 4v4M7 2v8h11M6 14h3m-3 3h5m-7-7h16v12H4z"/></svg>
            Print form
        </button>
    </header>

    <article class="nc-print-sheet" id="ncPrintSheet" aria-hidden="true">
        <header class="nc-print-header">
            <img src="~/images/logo.png" alt="TMCWD logo" />
            <div><strong>REPUBLIC OF THE PHILIPPINES</strong><h1>TRECE MARTIRES CITY WATER DISTRICT</h1><p>Brgy. San Agustin, Trece Martires City, Cavite</p></div>
            <div class="nc-print-title"><strong>NEW CONNECTION APPLICATION</strong><span>Application No.</span><b id="printTrackingNumber">—</b><span>Date Applied</span><b id="printDateApplied">—</b></div>
        </header>

        <section class="nc-print-section"><h2>Applicant and Service Information</h2><div class="nc-print-grid nc-print-grid--3">
            <div><span>Applicant Name</span><b id="printApplicantName">—</b></div><div><span>Consumer Type</span><b id="printConsumerType">—</b></div><div><span>Service Size</span><b id="printServiceSize">—</b></div>
            <div class="nc-print-wide"><span>Service Address</span><b id="printServiceAddress">—</b></div><div><span>Barangay</span><b id="printBarangay">—</b></div>
            <div><span>Mobile Number</span><b id="printMobile">—</b></div><div><span>Phone Number</span><b id="printPhone">—</b></div><div><span>Email Address</span><b id="printEmail">—</b></div>
            <div><span>Zone / Book</span><b id="printZoneBook">—</b></div><div><span>Nearest Account</span><b id="printNearestAccount">—</b></div><div><span>Nearest Account Name</span><b id="printNearestName">—</b></div>
            <div><span>Spouse Name</span><b id="printSpouse">—</b></div><div><span>People in Household</span><b id="printHousehold">—</b></div><div><span>Establishment / Business</span><b id="printEstablishment">—</b></div>
        </div></section>

        <section class="nc-print-section"><h2>Consumer Profile</h2><div class="nc-print-grid nc-print-grid--3">
            <div><span>Place of Birth</span><b id="printPlaceOfBirth">—</b></div><div><span>Birthdate / Age</span><b id="printBirthAge">—</b></div><div><span>Gender / Civil Status</span><b id="printGenderStatus">—</b></div>
            <div><span>Nature of Business</span><b id="printBusiness">—</b></div><div><span>Ownership Status</span><b id="printOwnership">—</b></div><div><span>Same as Applicant</span><b id="printSameApplicant">—</b></div>
            <div><span>Property Owner</span><b id="printOwnerName">—</b></div><div class="nc-print-wide"><span>Owner Address</span><b id="printOwnerAddress">—</b></div>
            <div class="nc-print-full"><span>Remarks</span><b id="printRemarks">—</b></div>
        </div></section>

        <section class="nc-print-section"><h2>Meter Connection and Requirements</h2><div class="nc-print-grid nc-print-grid--2">
            <div><span>Preferred Meter Location</span><b id="printMeterLocation">—</b></div><div><span>Connection Notes</span><b id="printConnectionNotes">—</b></div>
            <div class="nc-print-full"><span>Submitted Requirements</span><b id="printRequirements">—</b></div>
        </div></section>

        <footer class="nc-print-signatures">
            <div><span></span><b>Applicant's Signature over Printed Name</b><small>Date</small></div>
            <div><span></span><b>Received and Processed By</b><small>Date</small></div>
            <div><span></span><b>Approved By</b><small>Date</small></div>
        </footer>
        <p class="nc-print-note">This document was generated from the TMCWD New Connection Application system.</p>
    </article>

    <form id="newConnectionForm" novalidate>
        <div class="nc-card nc-overview">
            <div class="nc-overview__side">
                <label class="nc-field"><span>Application Number</span><input id="ncTrackingNumber" value="Generated after saving" readonly /></label>
                <label class="nc-field"><span>Date Applied</span><input id="ncDateApplied" type="date" value="@(Model.DateApplied?.ToString("yyyy-MM-dd"))" required /></label>
                <div class="nc-two">
                    <label class="nc-field"><span>Consumer Type</span><select id="ncConsumerType">
                        <option value="residential">Residential</option>
                        <option value="commercial">Commercial</option>
                        <option value="commercialA">Commercial A</option>
                        <option value="commercialB">Commercial B</option>
                        <option value="commercialC">Commercial C</option>
                        <option value="government">Government</option>
                        <option value="industrial">Industrial</option>
                        <option value="wholesale">Wholesale</option>
                        <option value="bulk">Bulk</option>
                    </select></label>
                    <label class="nc-field"><span>Service Size</span><select id="ncServiceSize">
                        <option value="">Select size</option>
                        <option value="0.5">½ inch</option>
                        <option value="0.75">¾ inch</option>
                        <option value="1">1 inch</option>
                        <option value="1.5">1½ inch</option>
                        <option value="2">2 inch</option>
                        <option value="3">3 inch</option>
                        <option value="4">4 inch</option>
                    </select></label>
                </div>
                <div class="nc-two">
                    <label class="nc-field"><span>Zone</span><select id="ncZone"><option value="">Select zone</option></select></label>
                    <label class="nc-field"><span>Book</span><select id="ncBook" disabled><option value="">Select book</option></select></label>
                </div>
                <fieldset class="nc-nearest">
                    <legend>Nearest Connection</legend>
                    <label class="nc-field"><span>Account Number</span><input id="ncNearestAccount" placeholder="Nearest account number" /></label>
                    <label class="nc-field"><span>Account Name</span><input id="ncNearestName" placeholder="Nearest account holder" /></label>
                </fieldset>
            </div>

            <div class="nc-applicant">
                <h2>Applicant Information <span aria-hidden="true">★</span></h2>
                <div class="nc-name-row">
                    <label class="nc-field"><span>Applicant Name</span><input id="ncApplicantName" maxlength="255" required /></label>
                    <label class="nc-field nc-suffix"><span>Suffix</span><input id="ncSuffix" maxlength="20" placeholder="Jr., Sr." /></label>
                </div>
                <label class="nc-field"><span>Barangay</span><select id="ncBarangay" required>
                    <option value="">Select barangay</option>
                    <option>Aguado</option>
                    <option>Cabezas</option>
                    <option>Cabuco</option>
                    <option>Conchu</option>
                    <option>De Ocampo</option>
                    <option>Gregorio</option>
                    <option>Inocencio</option>
                    <option>Lallana</option>
                    <option>Lapidario</option>
                    <option>Luciano</option>
                    <option>Osorio</option>
                    <option>Perez</option>
                    <option>San Agustin</option>
                </select></label>
                <label class="nc-field"><span>Unit No. / Block / Lot</span><input id="ncUnitNumber" maxlength="50" placeholder="Unit No., Block, or Lot" /></label>
                <label class="nc-field"><span>Building / Apartment</span><input id="ncBuilding" maxlength="100" placeholder="Building or apartment name" /></label>
                <div class="nc-two">
                    <label class="nc-field"><span>House No.</span><input id="ncHouseNumber" maxlength="20" placeholder="House number" /></label>
                    <label class="nc-field"><span>Street</span><input id="ncStreet" maxlength="150" placeholder="Street name" required /></label>
                </div>
                <div class="nc-three">
                    <label class="nc-field"><span>Mobile Number</span><input id="ncMobile" inputmode="numeric" maxlength="15" required /></label>
                    <label class="nc-field"><span>Phone Number</span><input id="ncPhone" maxlength="20" /></label>
                    <label class="nc-field"><span>Email Address</span><input id="ncEmail" type="email" maxlength="255" /></label>
                </div>
                <fieldset class="nc-additional">
                    <legend>Additional Information</legend>
                    <div class="nc-household-row">
                        <label class="nc-field"><span>Spouse Name</span><input id="ncSpouse" /></label>
                        <label class="nc-field nc-household"><span>People in Household</span><input id="ncHousehold" type="number" min="1" /></label>
                    </div>
                    <label class="nc-field"><span>Establishment / Business Name</span><input id="ncEstablishment" /></label>
                </fieldset>
            </div>
        </div>

        <div class="nc-tabs" role="tablist" aria-label="Application sections">
            <button type="button" class="is-active" data-nc-tab="profile">1. Consumer Profile</button>
            <button type="button" data-nc-tab="meter">2. Meter Connection</button>
            <button type="button" data-nc-tab="requirements">3. Requirements</button>
        </div>

        <div class="nc-card nc-tab-panel is-active" data-nc-panel="profile">
            <div class="nc-profile-grid">
                <div>
                    <label class="nc-field"><span>Place of Birth</span><input id="ncPlaceOfBirth" /></label>
                    <div class="nc-two"><label class="nc-field"><span>Birthdate</span><input id="ncBirthdate" type="date" /></label><label class="nc-field"><span>Age</span><input id="ncAge" readonly /></label></div>
                    <label class="nc-field"><span>Gender</span><select id="ncGender"><option value="">Select gender</option><option>Female</option><option>Male</option><option>Prefer not to say</option></select></label>
                    <label class="nc-field"><span>Civil Status</span><select id="ncCivilStatus"><option value="">Select status</option><option>Single</option><option>Married</option><option>Widowed</option><option>Separated</option></select></label>
                    <label class="nc-field"><span>Nature of Business</span><input id="ncBusiness" /></label>
                </div>
                <div>
                    <label class="nc-field"><span>Remarks</span><textarea id="ncRemarks" rows="3"></textarea></label>
                    <div class="nc-owner-row"><label class="nc-field"><span>Status of Ownership</span><select id="ncOwnership"><option value="">Select ownership</option><option>Owner</option><option>Tenant</option><option>Authorized occupant</option></select></label><label class="nc-check"><input id="ncSameApplicant" type="checkbox" /> Same as Applicant</label></div>
                    <label class="nc-field"><span>Name of Property Owner</span><input id="ncOwnerName" /></label>
                    <label class="nc-field"><span>Owner Address</span><textarea id="ncOwnerAddress" rows="2"></textarea></label>
                </div>
                <div class="nc-photo-box">
                    <div class="nc-photo-preview" id="ncPhotoPreview"><span>No photo uploaded</span></div>
                    <input id="ncPhoto" type="file" accept="image/*" hidden />
                    <button type="button" class="nc-secondary" id="ncUploadPhoto">Upload photo</button>
                    <button type="button" class="nc-outline" id="ncCapturePhoto">Use camera</button>
                </div>
            </div>
        </div>

        <div class="nc-card nc-tab-panel" data-nc-panel="meter" hidden>
            <div class="nc-section-grid">
                <label class="nc-field"><span>Preferred Meter Location</span><input id="ncMeterLocation" placeholder="Front boundary, left side, etc." /></label>
                <label class="nc-field"><span>Connection Notes</span><textarea id="ncConnectionNotes" rows="4" placeholder="Access instructions or relevant site information"></textarea></label>
            </div>
        </div>

        <div class="nc-card nc-tab-panel" data-nc-panel="requirements" hidden>
            <div class="nc-requirements">
                <label><input id="ncValidId" type="checkbox" /> Valid government-issued ID</label>
                <label><input id="ncOwnershipProof" type="checkbox" /> Proof of ownership or authorization</label>
                <label><input id="ncClearance" type="checkbox" /> Barangay clearance</label>
                <label><input id="ncSketch" type="checkbox" /> Location sketch</label>
            </div>
        </div>

        <div class="nc-form-footer">
            <p id="ncMessage" role="status"></p>
            <div><a class="nc-cancel" href="@Url.Action("Index", "Admin")">Cancel</a><button class="nc-submit" id="ncSubmit" type="submit">Submit Application</button></div>
        </div>
    </form>
</section>

@section Scripts {
    <script src="~/js/new-connection.js"></script>
}
