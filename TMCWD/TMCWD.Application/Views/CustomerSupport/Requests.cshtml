@{
    Layout = "_insideLayout";
}

@model TMCWD.Application.Models.RequestViewModel

<div class="p-6 bg-white border border-gray-200 rounded-lg shadow-sm mt-1">
    <h5 class="mb-2 text-2xl font-bold text-gray-900"></h5>
    <p class="text-gray-700">
        <div class="grid grid-cols-3 gap-4">
            <div class="col-span-2">
                <input type="text" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600" />
            </div>
            <div class="grid-column">
                <button class="rounded-md bg-blue-900 p-2 border border-transparent text-center text-sm text-white transition-all shadow-sm hover:shadow focus:bg-blue-700 focus:shadow-none active:bg-slate-700 hover:bg-slate-700 active:shadow-none disabled:pointer-events-none disabled:opacity-50 disabled:shadow-none"
                        type="button" id="btnSeachUser">
                    <svg width="20px" height="20px" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                        <path d="M17.545 15.467l-3.779-3.779a6.15 6.15 0 0 0 .898-3.21c0-3.417-2.961-6.377-6.378-6.377A6.185 6.185 0 0 0 2.1 8.287c0 3.416 2.961 6.377 6.377 6.377a6.15 6.15 0 0 0 3.115-.844l3.799 3.801a.953.953 0 0 0 1.346 0l.943-.943c.371-.371.236-.84-.135-1.211zM4.004 8.287a4.282 4.282 0 0 1 4.282-4.283c2.366 0 4.474 2.107 4.474 4.474a4.284 4.284 0 0 1-4.283 4.283c-2.366-.001-4.473-2.109-4.473-4.474z" style="fill:rgb(255, 255, 255)" />
                    </svg>
                </button>
                <button class="rounded-md bg-blue-900 p-2 border border-transparent text-center text-sm text-white transition-all shadow-sm hover:shadow focus:bg-blue-700 focus:shadow-none active:bg-slate-700 hover:bg-slate-700 active:shadow-none disabled:pointer-events-none disabled:opacity-50 disabled:shadow-none"
                        type="button"
                        onclick="location.href='@Url.Action("AddEditRequest", "CustomerSupport")'">
                    <svg width="20px" height="20px" viewBox="0 0 0.6 0.6" id="plus" data-name="Flat Color" xmlns="http://www.w3.org/2000/svg" class="icon flat-color">
                        <path id="primary" d="M0.3 0.5a0.025 0.025 0 0 1 -0.025 -0.025v-0.15H0.125a0.025 0.025 0 0 1 0 -0.05h0.15V0.125a0.025 0.025 0 0 1 0.05 0v0.15h0.15a0.025 0.025 0 0 1 0 0.05h-0.15v0.15a0.025 0.025 0 0 1 -0.025 0.025" style="fill: rgb(255, 255, 255);" />
                    </svg>
                </button>
            </div>
        </div>
    </p>
</div>

<div class="p-6 bg-white border border-gray-200 rounded-lg shadow-sm mt-1">
    <h5 class="mb-2 text-2xl font-bold text-gray-900">Requests</h5>
    <p class="text-gray-700">
        <!-- Requests Table -->

        <table id="tblRequests" class="w-full text-sm text-left rtl:text-right text-body border rounded-md">
            <thead>
                <tr class="border-b">
                    <th scope="col" class="px-6 py-3 font-medium">Control #</th>
                    <th scope="col" class="px-6 py-3 font-medium">Account #</th>
                    <th scope="col" class="px-6 py-3 font-medium">Customer</th>
                    <th scope="col" class="px-6 py-3 font-medium">Logged By</th>
                    <th scope="col" class="px-6 py-3 font-medium">Logged Date</th>
                    <th scope="col" class="px-6 py-3 font-medium">Status</th>
                    <th scope="col" class="px-6 py-3 font-medium"></th>
                </tr>
            </thead>
            @* <tbody>
                @if(Model.Requests == null || Model.Requests.Count <= 0)
                {
                    <tr>
                        <td colspan="6" class="border border-gray-300 text-center ...">No record(s) found . . .</td>
                    </tr>
                }
                else
                {
                    foreach(var request in Model.Requests)
                    {
                        <tr>
                            <td class="border border-gray-300 p-2 ...">@request.ControlNumber</td>
                            <td class="border border-gray-300 p-2 ...">
                                @(await Component.InvokeAsync("AccountNumber", new { accountId = request.AccountId }))</td>
                            <td data-customerid='@request.CustomerId' class="customer-detail border border-gray-300 p-2 ...">
                                <vc:customer-name customer-id="@request.CustomerId" paragraph-class="mb-0"></vc:customer-name>
                            </td>
                            <td data-userid='@request.CreatedBy' class="user-detail border border-gray-300 p-2 ...">@(await Component.InvokeAsync("UserName", new { userId = request.CreatedBy }))</td>
                            <td class="border border-gray-300 p-2 text-center ...">
                                @if(request.Status == RequestStatus.InProgress)
                                {
                                    <i class="fa-solid fa-clock text-yellow-500" aria-hidden="true"></i>
                                }
                                else
                                {
                                    <i class="fa-solid fa-check text-green-500"></i>
                                }
                            </td>
                            <td class="border border-gray-300 p-2 ...">
                                <a href="@Url.Action("AddEditRequest", "CustomerSupport", new { requestId = request.Id })" class="text-center text-gray hover:text-blue-600 transition-colors focus:outline-none p-2">
                                    <i class="fa fa-pencil" aria-hidden="true"></i>
                                </a>
                                <a id="lnkShowModal" command="show-modal" data-id="@request.Id" commandfor="deactivateModal" href="#" class="deactivateLink text-center text-gray hover:text-blue-600 transition-colors focus:outline-none p-2">
                                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody> *@
        </table>

        <!-- End Requests Table -->
    </p>
</div>

<script type="text/javascript">

    document.addEventListener("DOMContentLoaded", function(event) {
        const table = document.getElementById("tblRequests");
        table.DataTable({
            processing: true,
            stockCheck: { srcDataMember: 'quantity', compareToDataMember: 'requiredQuantity' },
            getUrl: '@Url.Action("GetRequests", "Request")',
            rowClassNames: 'border-b hover:bg-gray-100',
            columns: [
                { dataMember: 'controlNumber', isEditable: false },
                { dataMember: 'accountNumber', isEditable: false },
                { dataMember: 'customerName', isEditable: false },
                { dataMember: 'loggedBy', isEditable: false },
                { dataMember: 'loggedDate', isEditable: false },
                {
                    dataMember: 'status', 
                    isEditable: false, 
                    classNames: 'text-center',
                    displays: 
                    [
                        {
                            value: 1,
                            icon: 'fa-brands fa-firstdraft text-gray-500'
                        },
                        {
                            value: 2,
                            icon: 'fa-solid fa-clock text-yellow-500'
                        },
                        {
                            value: 3,
                            icon: 'fa-solid fa-check text-green-500'
                        },
                        {
                            value: 4,
                            icon: 'fa-solid fa-xmark text-red-500'
                        }
                    ]
                }
            ],
            buttonColumnClassNames: 'w-18',
            buttons:[
                { className: 'fa-solid fa-eye', isEditButton: false, clickCallback: (data) => { window.location.href = '@Url.Action("AddEditRequest", "CustomerSupport")' + '?requestId=' + data.id; } },
                { className: 'fas fa-trash', clickCallback: (data) => deleteData(data) }
            ]
        });
    });
</script>