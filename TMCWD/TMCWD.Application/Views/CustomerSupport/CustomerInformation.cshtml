@{
    Layout = "_InsideLayout";
    ViewData["ActivePage"] = "customers";
}
@model TMCWD.Application.Models.CustomerInformationViewModel

@{
    var hasCustomer = Model.Customer.Id > 0;
    var prevId      = Model.PreviousCustomerId;
    var nextId      = Model.NextCustomerId;
    var currentAcct = Model.SelectedAccount;
}

<div class="ci-page">

    @* ═══════════════════════════════════════════════
       TOOLBAR
       ═══════════════════════════════════════════ *@
    <div class="ci-toolbar">
        <div class="ci-toolbar__search-group">
            <div class="ci-toolbar__search-wrap">
                <input id="txtSearch" type="text" placeholder="Search account number…"
                       class="ci-input ci-input--search" autocomplete="off" />
                <ul id="searchDropdown" class="ci-search-dropdown hidden" role="listbox"></ul>
            </div>
            <input id="txtCustomerName" type="text" placeholder="Customer Name"
                   class="ci-input ci-input--acct" autocomplete="off" readonly
                   value="@(Model.Customer.Id > 0 ? Model.Customer.FullName : string.Empty)" />
        </div>

        <div class="ci-toolbar__actions">

            @* Previous — always an <a>, JS updates href *@
            <a id="btnPrev" href="#" class="ci-toolbar-btn ci-toolbar-btn--disabled" title="Previous customer">
                <svg viewBox="0 0 20 20" fill="none"><path d="M13 4l-6 6 6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>Previous</span>
            </a>

            @* Next — always an <a>, JS updates href *@
            <a id="btnNext" href="#" class="ci-toolbar-btn ci-toolbar-btn--disabled" title="Next customer">
                <svg viewBox="0 0 20 20" fill="none"><path d="M7 4l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>Next</span>
            </a>

            @* Ledger — button, opens ledger modal *@
            <button id="btnLedger" type="button" class="ci-toolbar-btn ci-toolbar-btn--disabled" title="View ledger" disabled>
                <svg viewBox="0 0 20 20" fill="none"><rect x="3" y="2" width="14" height="16" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M6 6h8M6 9h8M6 12h5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                <span>Ledger</span>
            </button>

            @* Adjustments — button, opens adjustments modal *@
            <button id="btnAdjustments" type="button" class="ci-toolbar-btn ci-toolbar-btn--disabled" title="Bill adjustments" disabled>
                <svg viewBox="0 0 20 20" fill="none"><rect x="3" y="2" width="14" height="16" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M6 6h8M6 9h5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path d="M6 13l1.5 1.5L11 11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>Adjust...</span>
            </button>

            @* Bills — button, opens modal *@
            <button id="btnBills" type="button" class="ci-toolbar-btn ci-toolbar-btn--disabled" title="View bills" disabled>
                <svg viewBox="0 0 20 20" fill="none"><rect x="2" y="4" width="16" height="12" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M6 8h8M6 12h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                <span>Bills</span>
            </button>

            @* Delete — button *@
            <button id="btnDelete" type="button" class="ci-toolbar-btn ci-toolbar-btn--danger ci-toolbar-btn--disabled" title="Delete customer" disabled>
                <svg viewBox="0 0 20 20" fill="none"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                <span>Delete</span>
            </button>

        </div>
    </div>

    @* ═══════════════════════════════════════════════
       BODY – two-column panels
       ═══════════════════════════════════════════ *@
    <div class="ci-body">

        @* ── LEFT: Customer Information ─────────────────── *@
        <section class="ci-panel" aria-label="Customer information">
            <div class="ci-panel-header">
                <h2 class="ci-panel__title" style="margin:0">
                    Customer Information
                    <svg class="ci-panel__title-icon" viewBox="0 0 20 20" fill="none">
                        <path d="M10 2l2.09 4.26L17 7.27l-3.5 3.41.83 4.82L10 13.27l-4.33 2.23.83-4.82L3 7.27l4.91-.71L10 2z"
                              stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                    </svg>
                </h2>
                <button id="btnEditCustomer" type="button" class="ci-btn ci-btn--edit">
                    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 16l1.5-4L14 3.5a1.5 1.5 0 0 1 2 2L7.5 14.5 4 16z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
                    <span>Edit</span>
                </button>
            </div>

            <div class="ci-fields" id="customerFields">

                @* Address (always readonly – computed) *@
                <div class="ci-field ci-field--full">
                    <input id="fldAddress" type="text" class="ci-input ci-readonly-field"
                           placeholder="Address" value="@(currentAcct?.FullAddress ?? string.Empty)" readonly />
                </div>

                @* Block / Lot *@
                <div class="ci-field">
                    <input id="fldBlock" type="text" class="ci-input ci-readonly-field"
                           placeholder="Block" value="@(currentAcct?.Building ?? string.Empty)" readonly />
                </div>
                <div class="ci-field">
                    <input id="fldLot" type="text" class="ci-input ci-readonly-field"
                           placeholder="Lot" value="@(currentAcct?.UnitNumber ?? string.Empty)" readonly />
                </div>

                @* Gender *@
                <div class="ci-field">
                    <select id="fldGender" class="ci-input ci-select ci-readonly-field" disabled>
                        <option value="">Gender</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                @* Email *@
                <div class="ci-field">
                    <input id="fldEmail" type="email" class="ci-input ci-readonly-field"
                           placeholder="Email Address" value="@Model.Customer.Email" readonly />
                </div>

                @* Mobile *@
                <div class="ci-field">
                    <input id="fldMobile" type="text" class="ci-input ci-readonly-field"
                           placeholder="Mobile Number" value="@Model.Customer.PhoneNumber" readonly />
                </div>

                @* Birthdate *@
                <div class="ci-field ci-field--has-icon">
                    <input id="fldBirthdate" type="text" class="ci-input ci-readonly-field"
                           placeholder="Birthdate" readonly />
                    <button type="button" class="ci-field-icon ci-date-trigger" aria-label="Pick date" disabled>
                        <svg viewBox="0 0 20 20" fill="none"><rect x="2" y="4" width="16" height="14" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M2 8h16M6 2v4M14 2v4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                    </button>
                </div>

                @* TIN *@
                <div class="ci-field">
                    <input id="fldTin" type="text" class="ci-input ci-readonly-field"
                           placeholder="TIN" readonly />
                </div>

                @* Guaranty Deposit *@
                <div class="ci-field">
                    <input id="fldDeposit" type="text" class="ci-input ci-readonly-field"
                           placeholder="Guaranty Deposit" readonly />
                </div>

                @* SC/PWD Discount *@
                <div class="ci-field ci-field--full">
                    <label class="ci-label">SC/PWD Discount</label>
                </div>

                <div class="ci-field ci-field--has-icon">
                    <select id="fldDiscountType" class="ci-input ci-select ci-readonly-field" disabled>
                        <option value="">Discount Type</option>
                        <option value="SeniorCitizen">Senior Citizen</option>
                        <option value="PWD">PWD</option>
                    </select>
                    <button type="button" class="ci-field-icon" aria-label="Discount history">
                        <svg viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="7.5" stroke="currentColor" stroke-width="1.4"/><path d="M10 6v4l3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                </div>

                <div class="ci-field">
                    <select id="fldDiscountSubtype" class="ci-input ci-select ci-readonly-field" disabled>
                        <option value=""></option>
                    </select>
                </div>

                @* Consumer Type *@
                <div class="ci-field ci-field--full">
                    <select id="fldConsumerType" class="ci-input ci-select ci-readonly-field" disabled>
                        <option value="">Consumer Type</option>
                        @foreach (var item in Model.AccountClassifications)
                        {
                            if (currentAcct != null && (int)currentAcct.Classification == int.Parse(item.Value))
                            {
                                <option value="@item.Value" selected>@item.Text</option>
                            }
                            else
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                </div>

                @* Zone *@
                <div class="ci-field ci-field--full">
                    <select id="fldZone" class="ci-input ci-select ci-readonly-field" disabled>
                        <option value="">Zone</option>
                        @if (currentAcct != null)
                        {
                            <option value="@currentAcct.ZoneBookId" selected>Zone Book #@currentAcct.ZoneBookId</option>
                        }
                    </select>
                </div>

                @* Book *@
                <div class="ci-field ci-field--full">
                    <select id="fldBook" class="ci-input ci-select ci-readonly-field" disabled>
                        <option value="">Book</option>
                    </select>
                </div>

                @* Sequence Number *@
                <div class="ci-field ci-field--full">
                    <input id="fldSequence" type="number" class="ci-input ci-readonly-field"
                           placeholder="Sequence Number"
                           value="@(currentAcct?.Sequence > 0 ? currentAcct.Sequence.ToString() : string.Empty)"
                           readonly />
                </div>

                @* Action buttons — hidden until Edit clicked *@
                <div id="customerActions" class="ci-field ci-field--full ci-field--actions ci-hidden">
                    <button id="btnSaveCustomer" type="button" class="ci-btn ci-btn--primary">Save</button>
                    <button id="btnCancelCustomer" type="button" class="ci-btn ci-btn--secondary">Cancel</button>
                </div>

            </div>
        </section>

        @* ── RIGHT: Meter Information ────────────────────── *@
        <section class="ci-panel" aria-label="Meter information">
            <div class="ci-panel-header">
                <h2 class="ci-panel__title" style="margin:0">Meter Information</h2>
                <button id="btnEditAccount" type="button" class="ci-btn ci-btn--edit">
                    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 16l1.5-4L14 3.5a1.5 1.5 0 0 1 2 2L7.5 14.5 4 16z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
                    <span>Edit</span>
                </button>
            </div>

            <div class="ci-fields" id="meterFields">

                @* Meter Number *@
                <div class="ci-field ci-field--full ci-field--has-icon">
                    <input id="fldMeterNumber" type="text" class="ci-input ci-readonly-field"
                           placeholder="Meter Number" value="@(currentAcct?.MeterNumber ?? string.Empty)" readonly />
                    <button type="button" class="ci-field-icon" aria-label="Locate meter">
                        <svg viewBox="0 0 20 20" fill="none"><path d="M10 2C7.24 2 5 4.24 5 7c0 4.25 5 11 5 11s5-6.75 5-11c0-2.76-2.24-5-5-5zm0 6.5A1.5 1.5 0 1 1 10 5a1.5 1.5 0 0 1 0 3.5z" fill="currentColor"/></svg>
                    </button>
                </div>

                @* Meter Brand *@
                <div class="ci-field">
                    <select id="fldMeterBrand" class="ci-input ci-select ci-readonly-field" disabled>
                        <option value="">Meter Brand</option>
                        <option value="Sensus">Sensus</option>
                        <option value="Amco">Amco</option>
                        <option value="Elster">Elster</option>
                        <option value="Kent">Kent</option>
                        <option value="Itron">Itron</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                @* Initial Reading *@
                <div class="ci-field">
                    <input id="fldInitialReading" type="number" step="0.01"
                           class="ci-input ci-readonly-field" placeholder="Initial Reading"
                           value="@(currentAcct?.InitialReading.ToString("0.##") ?? string.Empty)" readonly />
                </div>

                @* Installation Date *@
                <div class="ci-field ci-field--full ci-field--has-icon">
                    <input id="fldInstallationDate" type="text" class="ci-input ci-readonly-field"
                           placeholder="Installation Date"
                           value="@(currentAcct?.DateCreated.ToString("MM/dd/yyyy") ?? string.Empty)" readonly />
                    <button type="button" class="ci-field-icon ci-date-trigger" aria-label="Pick installation date" disabled>
                        <svg viewBox="0 0 20 20" fill="none"><rect x="2" y="4" width="16" height="14" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M2 8h16M6 2v4M14 2v4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                    </button>
                </div>

                @* Disconnection / Reconnection Date *@
                <div class="ci-field">
                    <input id="fldDisconnectionDate" type="text" class="ci-input ci-readonly-field"
                           placeholder="Disconnection Date" readonly />
                </div>
                <div class="ci-field">
                    <input id="fldReconnectionDate" type="text" class="ci-input ci-readonly-field"
                           placeholder="Reconnection Date" readonly />
                </div>

                @* Meter Size *@
                <div class="ci-field">
                    <label class="ci-label--sm">Meter Size</label>
                    <select id="fldMeterSize" class="ci-input ci-select ci-readonly-field" disabled>
                        <option value="">Meter Size</option>
                        @{
                            var meterSizes = new[] {
                                ("0.5",  "½\""),  ("0.75", "¾\""), ("1", "1\""),
                                ("1.5",  "1½\""), ("2",    "2\""), ("3", "3\""), ("4", "4\""),
                            };
                            foreach (var (sv, sl) in meterSizes)
                            {
                                if (currentAcct != null && currentAcct.MeterSize.ToString("G") == sv)
                                { <option value="@sv" selected>@sl</option> }
                                else
                                { <option value="@sv">@sl</option> }
                            }
                        }
                    </select>
                </div>

                @* Meter Status *@
                <div class="ci-field">
                    <label class="ci-label--sm">Meter Status</label>
                    <select id="fldMeterStatus" class="ci-input ci-select ci-readonly-field" disabled>
                        @foreach (var item in Model.AccountStatuses)
                        {
                            if (currentAcct != null && (int)currentAcct.Status == int.Parse(item.Value))
                            { <option value="@item.Value" selected>@item.Text</option> }
                            else
                            { <option value="@item.Value">@item.Text</option> }
                        }
                    </select>
                </div>

                @* Previous Reading *@
                <div class="ci-field">
                    <input id="fldPreviousReading" type="number" step="0.01"
                           class="ci-input ci-readonly-field" placeholder="Previous Reading" readonly />
                </div>

                @* Unbilled *@
                <div class="ci-field">
                    <input id="fldUnbilled" type="number" step="0.01"
                           class="ci-input" placeholder="Unbilled" readonly />
                </div>

                @* Penalty Exempt *@
                <div class="ci-field ci-field--full">
                    <label class="ci-label--sm">Penalty Exempt</label>
                    @if (currentAcct != null && currentAcct.Status == AccountStatus.Suspended)
                    {
                        <input id="chkPenaltyExempt" type="checkbox" class="ci-checkbox ci-readonly-field" checked disabled />
                    }
                    else
                    {
                        <input id="chkPenaltyExempt" type="checkbox" class="ci-checkbox ci-readonly-field" disabled />
                    }
                </div>

                @* Account save/cancel – hidden until Edit clicked *@
                <div id="meterActions" class="ci-field ci-field--full ci-field--actions ci-hidden">
                    <button id="btnSaveAccount" type="button" class="ci-btn ci-btn--primary">Save</button>
                    <button id="btnCancelAccount" type="button" class="ci-btn ci-btn--secondary">Cancel</button>
                </div>

            </div>
        </section>

    </div>

</div><!-- /.ci-page -->

<div id="ciToast" class="ci-toast ci-toast--hidden" role="status" aria-live="polite"></div>
<vc:modal-dialog type="deactivate"></vc:modal-dialog>

@* ── Ledger Modal (reused from Collections) ──────────────────── *@
<div class="ldg-overlay" id="ledgerOverlay" style="display:none;" aria-modal="true" role="dialog" aria-labelledby="ldgModalTitle">
  <div class="ldg-modal">
    <div class="ldg-header">
      <div class="ldg-header-left">
        <div class="ldg-header-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="18" height="18"><rect x="4" y="3" width="16" height="18" rx="1.5"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
        </div>
        <h2 class="ldg-title" id="ldgModalTitle">Ledger</h2>
      </div>
      <div class="ldg-header-right">
        <button class="ldg-menu-btn" id="ldgMenuBtn" type="button" aria-label="More options">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" width="18" height="18"><circle cx="12" cy="5" r="1.2" fill="currentColor"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/><circle cx="12" cy="19" r="1.2" fill="currentColor"/></svg>
        </button>
        <button class="ldg-close" id="ldgCloseBtn" type="button" aria-label="Close Ledger modal">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" width="18" height="18"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </div>
    </div>

    <div class="ldg-account-strip">
      <div class="ldg-account-fields">
        <div class="ldg-field"><span class="ldg-field-label">Account Name</span><span class="ldg-field-value" id="ldgAccName">—</span></div>
        <div class="ldg-field"><span class="ldg-field-label">Account No.</span><span class="ldg-field-value ldg-mono" id="ldgAccNo">—</span></div>
        <div class="ldg-field ldg-field--wide"><span class="ldg-field-label">Address</span><span class="ldg-field-value" id="ldgAddress">—</span></div>
      </div>
      <div class="ldg-account-meta">
        <div class="ldg-field"><span class="ldg-field-label">Rate Code</span><span class="ldg-field-value ldg-mono" id="ldgRateCode">—</span></div>
        <div class="ldg-field"><span class="ldg-field-label">Meter No.</span><span class="ldg-field-value ldg-mono" id="ldgMeterNo">—</span></div>
        <div class="ldg-field"><span class="ldg-field-label">Status</span><span class="ldg-status-badge" id="ldgStatus">—</span></div>
      </div>
      <div class="ldg-balance-block">
        <span class="ldg-balance-label">Total Balance</span>
        <span class="ldg-balance-value ldg-mono" id="ldgTotalBalance">₱0.00</span>
      </div>
    </div>

    <div class="ldg-actions-row">
      <button class="ldg-action-btn ldg-action-btn--pdf"   data-action="export-bills-pdf"    type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="12" y2="17"/></svg> Bills (PDF)</button>
      <button class="ldg-action-btn ldg-action-btn--excel" data-action="export-bills-excel"  type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18"/></svg> Bills (Excel)</button>
      <button class="ldg-action-btn ldg-action-btn--pdf"   data-action="export-others-pdf"   type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="12" y2="17"/></svg> Others (PDF)</button>
      <button class="ldg-action-btn ldg-action-btn--excel" data-action="export-others-excel" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18"/></svg> Others (Excel)</button>
      <button class="ldg-action-btn ldg-action-btn--sanitize" data-action="sanitize"          type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Sanitize</button>
    </div>

    <div class="ldg-tabs-row">
      <div class="ldg-tabs" role="tablist">
        <button class="ldg-tab ldg-tab--active" id="ldgTabBills"  role="tab" aria-selected="true"  aria-controls="ldgPanelBills"  type="button">Bills</button>
        <button class="ldg-tab"                 id="ldgTabOthers" role="tab" aria-selected="false" aria-controls="ldgPanelOthers" type="button">Other Charges</button>
      </div>
      <a href="#" class="ldg-history-link" id="ldgHistoryLink" aria-label="View full history">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> History
      </a>
    </div>

    <div class="ldg-panel" id="ldgPanelBills" role="tabpanel" aria-labelledby="ldgTabBills">
      <div class="ldg-table-wrap">
        <table class="ldg-table" id="ldgBillsTable">
          <thead><tr>
            <th class="ldg-col-ref">Ref No.</th>
            <th class="ldg-col-particulars">Particulars</th>
            <th class="ldg-col-num">Prev</th>
            <th class="ldg-col-num">Pres</th>
            <th class="ldg-col-num">Usage</th>
            <th class="ldg-col-num">Debit</th>
            <th class="ldg-col-num">Credit</th>
            <th class="ldg-col-num">Balance</th>
            <th class="ldg-col-by">Processed By</th>
          </tr></thead>
          <tbody id="ldgBillsBody">
            <tr class="ldg-empty-row" id="ldgBillsEmpty"><td colspan="9">No ledger entries found.</td></tr>
          </tbody>
        </table>
      </div>
      <div class="ldg-pagination">
        <div class="ldg-pagination-left">
          <span class="ldg-rows-label">Rows per page:</span>
          <div class="ldg-select-wrap">
            <select class="ldg-rows-select" id="ldgRowsPerPage">
              <option value="10" selected>10</option>
              <option value="25">25</option>
              <option value="50">50</option>
            </select>
            <svg class="ldg-select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="12" height="12"><path d="M6 9l6 6 6-6"/></svg>
          </div>
        </div>
        <div class="ldg-pagination-right">
          <span class="ldg-range-label" id="ldgRangeLabel">0–0 of 0</span>
          <button class="ldg-page-btn" id="ldgFirstBtn" aria-label="First page"    type="button" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="13" height="13"><path d="M11 17l-5-5 5-5"/><path d="M18 17l-5-5 5-5"/></svg></button>
