@{
    Layout = "_InsideLayout";
    ViewData["ActivePage"] = "customers";
    ViewData["Title"] = "Customer Information";
    ViewData["PageTitle"] = "Customer Information";
}
@model TMCWD.Application.Models.CustomerInformationViewModel

@{
    var hasCustomer = Model.Customer.Id > 0;
    var prevId      = Model.PreviousCustomerId;
    var nextId      = Model.NextCustomerId;
    var currentAcct = Model.SelectedAccount;
}

<div class="ci-page">
    @Html.AntiForgeryToken()
    <div class="ci-toolbar">
        <div class="ci-toolbar__search-wrap"><label for="txtSearch" class="ci-label">Search Account</label>
            <input id="txtSearch" type="search" placeholder="Account number or meter number" class="ci-input" autocomplete="off" role="combobox" aria-autocomplete="list" aria-controls="searchDropdown" aria-expanded="false" />
            <ul id="searchDropdown" class="ci-search-dropdown hidden" role="listbox" aria-label="Matching accounts"></ul>
        </div>
        <label class="ci-account-selector"><span class="ci-label">Customer accounts</span><select id="ciAccounts" class="ci-input" disabled></select></label>
        <nav class="ci-navigation" aria-label="Customer navigation">
            <a id="btnPrev" href="#" class="ci-toolbar-btn ci-toolbar-btn--disabled" aria-disabled="true">Previous</a>
            <a id="btnNext" href="#" class="ci-toolbar-btn ci-toolbar-btn--disabled" aria-disabled="true">Next</a>
        </nav>
    </div>
    <header class="ci-profile ci-panel">
        <div class="ci-profile-heading"><div><span class="ci-label">Customer profile</span><h2 id="ciCustomerName">—</h2><p class="ci-account-number">Account <strong id="ciAccountNumber">—</strong></p></div>
        </div>
        <input id="txtCustomerName" type="hidden" />
        <dl class="ci-profile-facts"><div><dt>Service Address</dt><dd id="ciProfileAddress">—</dd></div><div><dt>Meter Number</dt><dd id="ciProfileMeter">—</dd></div><div><dt>Classification</dt><dd id="ciProfileClassification">—</dd></div><div><dt>Current Balance</dt><dd id="ciProfileBalance">—</dd></div></dl>
        <div class="ci-account-actions" aria-label="Selected account actions">
            <button id="btnLedger" type="button" class="ci-btn ci-btn--primary" disabled>Ledger</button>
            <button id="btnBills" type="button" class="ci-btn" disabled>Bills</button>
            <button id="btnAdjustments" type="button" class="ci-btn" disabled>Adjustments</button>
            <details id="ciMore" class="ci-more"><summary class="ci-btn">More</summary><div class="ci-more-menu"><button id="btnDelete" type="button" class="ci-btn ci-btn--danger" disabled>Delete customer</button></div></details>
        </div>
    </header>
    <div class="ci-body">
        <section class="ci-panel" aria-labelledby="ciDetailsTitle"><div class="ci-panel-header"><h2 id="ciDetailsTitle">Customer Details</h2><button id="btnEditCustomer" type="button" class="ci-btn" disabled>Edit customer</button></div>
            <div class="ci-fields" id="customerFields"><div class="ci-field ci-field--full"><label class="ci-label" for="fldAddress">Service Address</label><span class="ci-value" data-ci-value="fldAddress">—</span><input id="fldAddress" type="text" class="ci-input" readonly /></div>
<div class="ci-field"><label class="ci-label" for="fldBlock">Block</label><span class="ci-value" data-ci-value="fldBlock">—</span><input id="fldBlock" type="text" class="ci-input" readonly /></div>
<div class="ci-field"><label class="ci-label" for="fldLot">Lot</label><span class="ci-value" data-ci-value="fldLot">—</span><input id="fldLot" type="text" class="ci-input" readonly /></div>
<div class="ci-field"><label class="ci-label" for="fldEmail">Email</label><span class="ci-value" data-ci-value="fldEmail">—</span><input id="fldEmail" type="email" class="ci-input ci-readonly-field" readonly /></div>
<div class="ci-field"><label class="ci-label" for="fldMobile">Mobile Number</label><span class="ci-value" data-ci-value="fldMobile">—</span><input id="fldMobile" type="text" class="ci-input ci-readonly-field" readonly /></div>
<div class="ci-field"><span class="ci-label">Gender</span><span class="ci-value">—</span></div>
<div class="ci-field"><span class="ci-label">Birthdate</span><span class="ci-value">—</span></div>
<div class="ci-field"><span class="ci-label">TIN</span><span class="ci-value">—</span></div>
<div class="ci-field"><span class="ci-label">Guaranty Deposit</span><span class="ci-value">—</span></div>
<div class="ci-field"><span class="ci-label">SC/PWD Discount</span><span class="ci-value">—</span></div>
<div class="ci-field"><span class="ci-label">Zone</span><span id="fldZone" class="ci-value">—</span></div>
<div class="ci-field"><span class="ci-label">Book</span><span id="fldBook" class="ci-value">—</span></div>
<div class="ci-field"><label class="ci-label" for="fldSequence">Sequence Number</label><span class="ci-value" data-ci-value="fldSequence">—</span><input id="fldSequence" type="number" class="ci-input" readonly /></div>
                <div id="customerActions" class="ci-field ci-field--full ci-field--actions ci-hidden"><button id="btnSaveCustomer" type="button" class="ci-btn ci-btn--primary">Save</button><button id="btnCancelCustomer" type="button" class="ci-btn">Cancel</button></div>
            </div>
        </section>
        <section class="ci-panel" aria-labelledby="ciMeterTitle"><div class="ci-panel-header"><h2 id="ciMeterTitle">Meter &amp; Service</h2><button id="btnEditAccount" type="button" class="ci-btn" disabled>Edit account</button></div>
            <div class="ci-fields" id="meterFields"><div class="ci-field ci-field--full"><label class="ci-label" for="fldMeterNumber">Meter Number</label><span class="ci-value" data-ci-value="fldMeterNumber">—</span><input id="fldMeterNumber" type="text" class="ci-input ci-readonly-field" readonly /></div>
<div class="ci-field"><label class="ci-label" for="fldMeterSize">Meter Size</label><span class="ci-value" data-ci-value="fldMeterSize">—</span><select id="fldMeterSize" class="ci-input ci-readonly-field" disabled><option value="">—</option><option value="0.5">0.5 inch</option><option value="0.75">0.75 inch</option><option value="1">1 inch</option><option value="1.5">1.5 inch</option><option value="2">2 inch</option><option value="3">3 inch</option><option value="4">4 inch</option></select></div>
<div class="ci-field"><label class="ci-label" for="fldConsumerType">Classification</label><span class="ci-value" data-ci-value="fldConsumerType">—</span><select id="fldConsumerType" class="ci-input ci-readonly-field" disabled><option value="">—</option>@foreach (var item in Model.AccountClassifications) { <option value="@item.Value">@item.Text</option> }</select></div>
<div class="ci-field"><label class="ci-label" for="fldInitialReading">Initial Reading</label><span class="ci-value" data-ci-value="fldInitialReading">—</span><input id="fldInitialReading" type="number" class="ci-input" readonly /></div>
<div class="ci-field"><label class="ci-label" for="fldInstallationDate">Account Enrolled</label><span class="ci-value" data-ci-value="fldInstallationDate">—</span><input id="fldInstallationDate" type="text" class="ci-input" readonly /></div>
<div class="ci-field"><span class="ci-label">Meter Brand</span><span class="ci-value">—</span></div>
<div class="ci-field"><span class="ci-label">Meter Status</span><span class="ci-value">—</span></div>
<div class="ci-field"><span class="ci-label">Installation Date</span><span class="ci-value">—</span></div>
<div class="ci-field"><span class="ci-label">Previous Reading</span><span class="ci-value">—</span></div>
<div class="ci-field"><span class="ci-label">Unbilled Usage</span><span class="ci-value">—</span></div>
<div class="ci-field"><span class="ci-label">Penalty Exempt</span><span class="ci-value">—</span></div>
<div class="ci-field"><label class="ci-label" for="fldMeterStatus">Operational Account Status</label><span id="ciOperationalStatus" class="ci-status ci-status--neutral" data-ci-value="fldMeterStatus">—</span><select id="fldMeterStatus" class="ci-input" disabled><option value="">—</option>@foreach (var item in Model.AccountStatuses) { <option value="@item.Value">@item.Text</option> }</select></div>
<div class="ci-field ci-field--full"><span class="ci-label">Physical Service Status</span><span id="ciPhysicalStatus" class="ci-status ci-status--neutral">—</span></div>
<div class="ci-field ci-field--full"><span class="ci-label">Monitoring Status</span><span id="ciMonitoringStatus" class="ci-status ci-status--neutral">—</span></div>
<div class="ci-field"><span class="ci-label">Disconnection Date</span><span id="ciDisconnectionDate" class="ci-value">—</span></div>
<div class="ci-field"><span class="ci-label">Reconnection Date</span><span id="ciReconnectionDate" class="ci-value">—</span></div>
                <div id="meterActions" class="ci-field ci-field--full ci-field--actions ci-hidden"><button id="btnSaveAccount" type="button" class="ci-btn ci-btn--primary">Save</button><button id="btnCancelAccount" type="button" class="ci-btn">Cancel</button></div>
            </div>
            <p id="ciServiceReadState" class="ci-muted" role="status" aria-live="polite" hidden></p>
            <button id="ciRefreshService" type="button" class="ci-btn" disabled>Refresh service status</button>
        </section>
    </div>
</div>

<div id="ciToast" class="ci-toast ci-toast--hidden" role="status" aria-live="polite"></div>
<vc:modal-dialog type="deactivate"></vc:modal-dialog>

<partial name="_AccountLedger" />

@* ── Adjustments Modal ───────────────────────────────────────── *@
<div id="adjModal" class="adj-backdrop adj-hidden" role="dialog" aria-modal="true" aria-labelledby="adjModalTitle">
    <div class="adj-dialog">
        <div class="adj-header">
            <h3 id="adjModalTitle" class="adj-title">
                <span id="adjCustomerLabel"></span>
            </h3>
            <button id="btnCloseAdj" type="button" class="adj-close" aria-label="Close">
                <svg viewBox="0 0 20 20" fill="none"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </button>
        </div>

        <div class="adj-tabs" role="tablist">
            <button id="adjTabDcm" class="adj-tab adj-tab--active" role="tab" aria-selected="true"  aria-controls="adjPanelDcm"  type="button">Debit/Credit</button>
            <button id="adjTabAdj" class="adj-tab"                 role="tab" aria-selected="false" aria-controls="adjPanelAdj"  type="button">Bill Adjustment</button>
        </div>

        @* Debit/Credit panel *@
        <div id="adjPanelDcm" class="adj-panel" role="tabpanel" aria-labelledby="adjTabDcm">
            <table class="adj-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Memo</th>
                        <th class="adj-num">Amount</th>
                        <th>Explanation</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody id="adjDcmBody">
                    <tr><td colspan="6" class="adj-empty">No debit/credit memos found.</td></tr>
                </tbody>
            </table>
        </div>

        @* Bill Adjustment panel *@
        <div id="adjPanelAdj" class="adj-panel adj-hidden" role="tabpanel" aria-labelledby="adjTabAdj">
            <table class="adj-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Billing Reference</th>
                        <th>Period</th>
                        <th>Type</th>
                        <th class="adj-num">Amount</th>
                    </tr>
                </thead>
                <tbody id="adjAdjBody">
                    <tr><td colspan="5" class="adj-empty">No bill adjustments found.</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Styles {
<link rel="stylesheet" href="~/css/collections.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/customer-information.css" asp-append-version="true" />
}

@section Scripts {
<script>
(function () {
    'use strict';

    /* ── Server data ────────────────────────────────────────── */
    const CUSTOMER_ID  = @(Model.Customer.Id);
    const ACCOUNT_ID   = @(currentAcct?.Id ?? 0);
    const CUSTOMER_IDS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CustomerIds));
    const SEED = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { customer = Model.Customer, accounts = Model.CustomerAccounts, selectedAccount = Model.SelectedAccount }, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)));

    /* ── URLs ───────────────────────────────────────────────── */
    const URL_SEARCH_ACCOUNT = '@Url.Action("SearchByAccount",          "CustomerSupport")';
    const URL_LOAD          = '@Url.Action("GetCustomerInformationData", "CustomerSupport")';
    const URL_SAVE_CUSTOMER = '@Url.Action("SaveCustomerInformation",    "CustomerSupport")';
    const URL_SAVE_ACCOUNT  = '@Url.Action("SaveAccountInformation",     "CustomerSupport")';
    const URL_DEACTIVATE    = '@Url.Action("DeactivateCustomer",         "CustomerSupport")';
    const URL_CI            = '@Url.Action("CustomerInformation",        "CustomerSupport")';
    const URL_ACCT_INDEX    = '@Url.Action("Index",                      "Account")';

    /* ── Refs ───────────────────────────────────────────────── */
    const $ = id => document.getElementById(id);

    const txtSearch      = $('txtSearch');
    const txtCustomerName = $('txtCustomerName');
    const toast        = $('ciToast');

    // Customer fields
    const fldAddress      = $('fldAddress');
    const fldBlock        = $('fldBlock');
    const fldLot          = $('fldLot');
    const fldEmail        = $('fldEmail');
    const fldMobile       = $('fldMobile');
    const fldConsumerType = $('fldConsumerType');
    const fldSequence     = $('fldSequence');

    // Meter fields
    const fldMeterNumber  = $('fldMeterNumber');
    const fldInitReading  = $('fldInitialReading');
    const fldInstallDate  = $('fldInstallationDate');
    const fldMeterSize    = $('fldMeterSize');
    const fldMeterStatus  = $('fldMeterStatus');

    /* ── State ──────────────────────────────────────────────── */
    let currentCustomerId = CUSTOMER_ID;
    let currentAccountId  = ACCOUNT_ID;
    let customerEditMode  = false;
    let meterEditMode     = false;
    // Snapshot for cancel
    let customerSnapshot  = {};
    let meterSnapshot     = {};
    let selectedAccount = null, currentAccounts = [], zoneBooks = [];

    function syncReadOnlyValues() {
        document.querySelectorAll('[data-ci-value]').forEach(value => {
            const field = $(value.dataset.ciValue);
            const text = field.tagName === 'SELECT' ? field.selectedOptions[0]?.textContent : field.value;
            value.textContent = text?.trim() || '—';
        });
        $('ciCustomerName').textContent = txtCustomerName.value.trim() || '—';
        $('ciAccountNumber').textContent = selectedAccount?.accountNumber || '—';
        $('ciProfileAddress').textContent = fldAddress.value.trim() || '—';
        $('ciProfileMeter').textContent = fldMeterNumber.value.trim() || '—';
        $('ciProfileClassification').textContent = fldConsumerType.selectedOptions[0]?.textContent || '—';
    }
    function renderZoneBook() {
        const zoneBook = zoneBooks.find(z => z.id === selectedAccount?.zoneBookId);
        $('fldZone').textContent = zoneBook?.zone ?? '—';
        $('fldBook').textContent = zoneBook?.book ?? '—';
    }

    /* ── Edit mode helpers ──────────────────────────────────── */

    // All .ci-readonly-field elements inside a container
    function getEditableFields(containerId) {
        return document.querySelectorAll(`#${containerId} .ci-readonly-field`);
    }

    function enablePanel(containerId, actionsId, editBtnId) {
        $(containerId).classList.add('ci-editing');
        getEditableFields(containerId).forEach(el => {
            if (el.tagName === 'SELECT' || el.type === 'checkbox') {
                el.disabled = false;
            } else {
                el.readOnly = false;
            }
            el.classList.remove('ci-input'); // briefly remove then re-add to force repaint
            el.classList.add('ci-input');
        });
        // Enable date trigger buttons
        document.querySelectorAll(`#${containerId} .ci-date-trigger`).forEach(b => b.disabled = false);
        $(actionsId).classList.remove('ci-hidden');
        const editBtn = $(editBtnId);
        if (editBtn) { editBtn.classList.add('ci-hidden'); }
        getEditableFields(containerId)[0]?.focus();
    }

    function disablePanel(containerId, actionsId, editBtnId) {
        $(containerId).classList.remove('ci-editing');
        getEditableFields(containerId).forEach(el => {
            if (el.tagName === 'SELECT' || el.type === 'checkbox') {
                el.disabled = true;
            } else {
                el.readOnly = true;
            }
        });
        document.querySelectorAll(`#${containerId} .ci-date-trigger`).forEach(b => b.disabled = true);
        $(actionsId).classList.add('ci-hidden');
        const editBtn = $(editBtnId);
        if (editBtn) { editBtn.classList.remove('ci-hidden'); }
        syncReadOnlyValues();
    }

    // Snapshot current values so Cancel can restore them
    function snapshotFields(containerId) {
        const snap = {};
        document.querySelectorAll(`#${containerId} .ci-readonly-field`).forEach(el => {
            snap[el.id] = el.type === 'checkbox' ? el.checked : el.value;
        });
        return snap;
    }

    function restoreSnapshot(snap) {
        Object.entries(snap).forEach(([id, val]) => {
            const el = $(id); if (!el) return;
            if (el.type === 'checkbox') el.checked = val;
            else el.value = val;
        });
    }

    /* ── Edit Customer button ───────────────────────────────── */
    $('btnEditCustomer').addEventListener('click', () => {
        customerEditMode    = true;
        customerSnapshot    = snapshotFields('customerFields');
        enablePanel('customerFields', 'customerActions', 'btnEditCustomer');
    });

    /* ── Edit Account (meter) button ────────────────────────── */
    $('btnEditAccount').addEventListener('click', () => {
        meterEditMode    = true;
        meterSnapshot    = snapshotFields('meterFields');
        enablePanel('meterFields', 'meterActions', 'btnEditAccount');
    });

    /* ── Toast ──────────────────────────────────────────────── */
    function showToast(msg, type = 'success') {
        toast.textContent = msg;
        toast.className   = `ci-toast ci-toast--${type}`;
        clearTimeout(toast._t);
        toast._t = setTimeout(() => { toast.className = 'ci-toast ci-toast--hidden'; }, 3500);
    }

    /* ── Populate all fields from API payload ───────────────── */
    function populatePage(data) {
        const c       = data.customer;
        const a       = data.selectedAccount;
        const accounts = data.accounts || [];

        currentCustomerId = c.id;
        currentAccountId  = a ? a.id : 0;
        selectedAccount = a || null;
        currentAccounts = accounts;
        $('ciAccounts').replaceChildren(...accounts.map(account => new Option(account.accountNumber, account.accountNumber)));
        $('ciAccounts').disabled = accounts.length < 2;
        $('ciAccounts').value = a?.accountNumber || '';
        setActiveAccountNumber(a?.accountNumber ?? '');

        // Customer
        fldEmail.value  = c.email       ?? '';
        fldMobile.value = c.phoneNumber ?? '';
        // Show customer full name in the toolbar name field
        txtCustomerName.value = c.fullName?.trim() || [c.lastname, [c.firstname, c.middlename].filter(Boolean).join(' ')].filter(Boolean).join(', ');

        // Account / meter
        if (a) {
            const addr = [a.unitNumber, a.building, a.houseNumber, a.street, a.barangay]
                          .filter(Boolean).join(' ');
            fldAddress.value      = addr;
            fldBlock.value        = a.building    ?? '';
            fldLot.value          = a.unitNumber  ?? '';
            fldMeterNumber.value  = a.meterNumber ?? '';
            fldInitReading.value  = a.initialReading ?? '';
            fldInstallDate.value  = a.dateCreated
                ? new Date(a.dateCreated).toLocaleDateString('en-US') : '';
            fldSequence && (fldSequence.value = a.sequence > 0 ? a.sequence : '');
            setSelect(fldMeterSize,    String(a.meterSize      ?? ''));
            setSelect(fldMeterStatus,  String(a.status         ?? ''));
            setSelect(fldConsumerType, String(a.classification ?? ''));
        } else {
            [fldAddress, fldBlock, fldLot, fldMeterNumber, fldInitReading, fldInstallDate, fldSequence].forEach(field => field.value = '');
            [fldMeterSize, fldMeterStatus, fldConsumerType].forEach(field => field.value = '');
        }
        renderZoneBook(); syncReadOnlyValues();

        // Always reload in view (readonly) mode after switching customer
        if (customerEditMode) {
            disablePanel('customerFields', 'customerActions', 'btnEditCustomer');
            customerEditMode = false;
        }
        if (meterEditMode) {
            disablePanel('meterFields', 'meterActions', 'btnEditAccount');
            meterEditMode = false;
        }

        // Nav buttons
        const idx    = CUSTOMER_IDS.indexOf(c.id);
        const prevId = idx > 0                              ? CUSTOMER_IDS[idx - 1] : null;
        const nextId = idx < CUSTOMER_IDS.length - 1       ? CUSTOMER_IDS[idx + 1] : null;
        setNavBtn('btnPrev', prevId);
        setNavBtn('btnNext', nextId);
        setToolbarEnabled(!!a);
        updateToolbarLinks(c.id, a ? (a.accountNumber ?? '') : '');
    }

    /* ── Switch meter panel to a different account row ──────── */
    function switchToAccount(acct) {
        selectedAccount = acct;
        currentAccountId = acct.id;
        $('ciAccounts').value = acct.accountNumber;

        // Highlight
        document.querySelectorAll('.ci-account-row').forEach(r => {
            r.classList.toggle('ci-account-row--active', parseInt(r.dataset.accountId) === acct.id);
        });

        // Always go back to readonly when switching accounts
        if (meterEditMode) {
            disablePanel('meterFields', 'meterActions', 'btnEditAccount');
            meterEditMode = false;
        }

        const addr = [acct.unitNumber, acct.building, acct.houseNumber, acct.street, acct.barangay]
                      .filter(Boolean).join(' ');
        fldAddress.value     = addr;
        fldBlock.value       = acct.building    ?? '';
        fldLot.value         = acct.unitNumber  ?? '';
        fldMeterNumber.value = acct.meterNumber ?? '';
        fldInitReading.value = acct.initialReading ?? '';
        fldInstallDate.value = acct.dateCreated
            ? new Date(acct.dateCreated).toLocaleDateString('en-US') : '';
        fldSequence && (fldSequence.value = acct.sequence > 0 ? acct.sequence : '');
        setSelect(fldMeterSize,    String(acct.meterSize      ?? ''));
        setSelect(fldMeterStatus,  String(acct.status         ?? ''));
        setSelect(fldConsumerType, String(acct.classification ?? ''));
        updateToolbarLinks(currentCustomerId, acct.accountNumber ?? '');
        setActiveAccountNumber(acct.accountNumber ?? '');
        setToolbarEnabled(true);
        renderZoneBook(); syncReadOnlyValues();

    }

    /* ── Helpers ────────────────────────────────────────────── */
    function setSelect(el, val) {
        if (!el) return;
        for (const o of el.options) if (o.value === val) { o.selected = true; return; }
        el.value = '';
    }
    function setNavBtn(id, targetId) {
        const btn = $(id); if (!btn) return;
        if (targetId) { btn.href = `${URL_CI}?customerId=${targetId}`; btn.classList.remove('ci-toolbar-btn--disabled'); }
        else          { btn.href = '#'; btn.classList.add('ci-toolbar-btn--disabled'); }
        btn.setAttribute('aria-disabled', String(!targetId)); btn.tabIndex = targetId ? 0 : -1;
    }
    function setToolbarEnabled(on) {
        ['btnLedger','btnAdjustments','btnBills','btnDelete'].forEach(id => {
            const el = $(id); if (!el) return;
            on ? el.classList.remove('ci-toolbar-btn--disabled') : el.classList.add('ci-toolbar-btn--disabled');
            if (el.tagName === 'BUTTON') el.disabled = !on;
        });
        $('btnEditCustomer').disabled = !currentCustomerId;
        $('btnEditAccount').disabled = !currentAccountId;
        $('ciRefreshService').disabled = !selectedAccount;
        $('btnDelete').disabled = !currentCustomerId;
    }

    /* ── Update toolbar link hrefs when a customer/account is loaded ── */
    function updateToolbarLinks(customerId, accountNumber) {
        // Adjustments and Ledger are now modals — nothing to href-update
    }

    $('btnLedger').addEventListener('click', () => {
        if (!_currentAccountNumber) { showToast('No account selected.', 'error'); return; }
        window.openAccountLedger(_currentAccountNumber);
    });

    /* ── Load customer via AJAX ─────────────────────────────── */
    let customerLoadVersion = 0;
    async function loadCustomer(id, accountId) {
        if (!id) return;
        const version = ++customerLoadVersion;
        try {
            const res = await fetch(`${URL_LOAD}?customerId=${id}`);
            if (version !== customerLoadVersion) return;
            if (!res.ok) { showToast('Customer not found.', 'error'); return; }
            const data = await res.json();
            if (version !== customerLoadVersion) return;
            // Search selects an exact account, not the customer's default account.
            if (accountId != null) {
                data.selectedAccount = (data.accounts || []).find(a => a.id === accountId);
                if (!data.selectedAccount) { showToast('Selected account not found.', 'error'); return; }
            }
            populatePage(data);
        } catch { if (version === customerLoadVersion) showToast('Failed to load customer.', 'error'); }
    }

    /* ── Search by account number ───────────────────────────── */
    let _st;
    txtSearch.addEventListener('input', () => {
        clearTimeout(_st);
        const q = txtSearch.value.trim();
        if (q.length < 2) { hideDropdown(); return; }
        _st = setTimeout(() => doSearch(q), 280);
    });
    async function doSearch(q) {
        try {
            const res = await fetch(`${URL_SEARCH_ACCOUNT}?q=${encodeURIComponent(q)}`);
            const data = res.ok ? await res.json() : [];
            if (txtSearch.value.trim() === q) renderDropdown(data);
        } catch { renderDropdown([]); }
    }
    function renderDropdown(list) {
        const dd = $('searchDropdown');
        dd.innerHTML = '';
        if (!list.length) {
            dd.innerHTML = '<li class="ci-dropdown-empty">No accounts found.</li>';
        } else {
            list.forEach(item => {
                const li = document.createElement('li');
                li.setAttribute('role', 'option');
                // Show account number + customer name
                const number = document.createElement('span'), name = document.createElement('span');
                number.className = 'ci-dd-acct'; number.textContent = item.accountNumber;
                name.className = 'ci-dd-name'; name.textContent = item.customerName;
                li.append(number, name); li.tabIndex = 0;
                li.dataset.customerId = item.customerId;
                li.dataset.accountId  = item.accountId;
                li.addEventListener('click', () => {
                    hideDropdown();
                    setActiveAccountNumber(_currentAccountNumber);
                    loadCustomer(item.customerId, item.accountId);
                });
                li.addEventListener('keydown', event => {
                    if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); li.click(); }
                    if (event.key === 'Escape') { hideDropdown(); txtSearch.focus(); }
                    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
                        event.preventDefault(); (event.key === 'ArrowDown' ? li.nextElementSibling : li.previousElementSibling)?.focus();
                    }
                });
                dd.appendChild(li);
            });
        }
        dd.classList.remove('hidden');
        txtSearch.setAttribute('aria-expanded', 'true');
    }
    function hideDropdown() { $('searchDropdown').classList.add('hidden'); txtSearch.setAttribute('aria-expanded', 'false'); }
    txtSearch.addEventListener('keydown', event => {
        if (event.key === 'ArrowDown') { event.preventDefault(); $('searchDropdown').querySelector('[role=option]')?.focus(); }
        if (event.key === 'Escape') hideDropdown();
    });
    document.addEventListener('click', e => {
        if (!txtSearch.contains(e.target) && !$('searchDropdown').contains(e.target)) hideDropdown();
    });

    /* ── Customer name field is readonly — no keydown handler needed ── */

    /* ── Save Customer ──────────────────────────────────────── */
    $('btnSaveCustomer').addEventListener('click', async () => {
        const savingCustomerId = currentCustomerId;
        const email = fldEmail.value.trim(), phoneNumber = fldMobile.value.trim();
        let base = {};
        try {
            const r = await fetch(`${URL_LOAD}?customerId=${savingCustomerId}`);
            if (r.ok) base = (await r.json()).customer ?? {};
        } catch { /* proceed */ }

        const payload = { ...base, email, phoneNumber, dateUpdated: new Date().toISOString() };
        try {
            const res = await fetch(URL_SAVE_CUSTOMER, { method:'POST', headers:{'Content-Type':'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value}, body:JSON.stringify(payload) });
            if (res.ok) {
                showToast('Customer saved.');
                if (currentCustomerId === savingCustomerId) {
                    customerEditMode = false;
                    disablePanel('customerFields', 'customerActions', 'btnEditCustomer');
                }
            } else {
                showToast('Failed to save customer.', 'error');
            }
        } catch { showToast('Failed to save customer.', 'error'); }
    });

    /* ── Cancel Customer ────────────────────────────────────── */
    $('btnCancelCustomer').addEventListener('click', () => {
        restoreSnapshot(customerSnapshot);
        customerEditMode = false;
        disablePanel('customerFields', 'customerActions', 'btnEditCustomer');
    });

    /* ── Save Account ───────────────────────────────────────── */
    $('btnSaveAccount').addEventListener('click', async () => {
        if (!currentAccountId) { showToast('No account selected.', 'error'); return; }
        const accountId = currentAccountId, customerId = currentCustomerId;
        const edited = { meterNumber: fldMeterNumber.value.trim(), meterSize: parseFloat(fldMeterSize?.value || '0') || 0,
            status: parseInt(fldMeterStatus?.value || '1', 10), classification: parseInt(fldConsumerType?.value || '1', 10),
            initialReading: parseFloat(fldInitReading?.value || '0') || 0 };
        let base = {};
        try {
            const r = await fetch(`${URL_LOAD}?customerId=${customerId}`);
            if (r.ok) { const d = await r.json(); base = d.accounts.find(a => a.id === accountId) ?? {}; }
        } catch { /* proceed */ }

        const payload = {
            ...base,
            id: accountId, customerId,
            ...edited,
            dateUpdated:    new Date().toISOString(),
        };
        try {
            const res = await fetch(URL_SAVE_ACCOUNT, { method:'POST', headers:{'Content-Type':'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value}, body:JSON.stringify(payload) });
            if (res.ok) {
                const saved = await res.json();
                currentAccounts = currentAccounts.map(a => a.id === saved.id ? saved : a);
                showToast('Account saved.');
                if (currentAccountId === saved.id) {
                    meterEditMode = false;
                    disablePanel('meterFields', 'meterActions', 'btnEditAccount');
                    switchToAccount(saved);
                }
            } else {
                showToast('Failed to save account.', 'error');
            }
        } catch { showToast('Failed to save account.', 'error'); }
    });

    /* ── Cancel Account ─────────────────────────────────────── */
    $('btnCancelAccount').addEventListener('click', () => {
        restoreSnapshot(meterSnapshot);
        meterEditMode = false;
        disablePanel('meterFields', 'meterActions', 'btnEditAccount');
    });

    /* ── Delete ─────────────────────────────────────────────── */
    $('btnDelete').addEventListener('click', () => {
        if (!currentCustomerId) return;
        new ModalDialog({
            type: 'deactivate', title: 'Deactivate Customer',
            content: 'Are you sure you want to deactivate this customer? This action cannot be undone.',
            submitCallback: async () => {
                const response = await fetch(`${URL_DEACTIVATE}?customerId=${currentCustomerId}`, { method: 'POST',
                    headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value } });
                if (response.ok) window.location.href = URL_CI;
                else showToast('Could not deactivate customer.', 'error');
            }
        }).show();
    });

    let _currentAccountNumber = '';
    let serviceStatusVersion = 0;
    const summaryMoney = value => typeof value === 'number' && Number.isFinite(value) ? new Intl.NumberFormat('en-PH', { style: 'currency', currency: 'PHP' }).format(value) : '—';
    const summaryDate = value => value && !String(value).startsWith('0001-') ? new Date(String(value).slice(0, 10) + 'T00:00:00Z').toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) : '—';
    function setBadge(id, status) {
        const value = String(status || '—').trim().toLowerCase();
        const kind = ['active', 'paid', 'reconnected', 'eligible for reconnection'].includes(value) ? 'success' :
            ['disconnected', 'for disconnection', 'unpaid'].includes(value) ? 'danger' :
            value === 'financial / service state review required' ? 'review' :
            value === 'subject for disconnection' ? 'subject' :
            ['first bill unpaid', 'balance + reconnection fee pending'].includes(value) ? 'warning' : 'neutral';
        $(id).className = 'ci-status ci-status--' + kind; $(id).textContent = status || '—';
    }
    function setActiveAccountNumber(acctNo) {
        _currentAccountNumber = acctNo;
        txtSearch.value = acctNo;
        refreshServiceStatus(acctNo);
    }
    async function refreshServiceStatus(acctNo) {
        const version = ++serviceStatusVersion;
        const indicator = $('ciServiceReadState');
        ['ciProfileBalance','ciPhysicalStatus','ciDisconnectionDate','ciReconnectionDate'].forEach(id => $(id).textContent = '—');
        setBadge('ciMonitoringStatus', '—'); setBadge('ciPhysicalStatus', '—');
        setBadge('ciOperationalStatus', ['—', 'Pending', 'Suspended', 'Active', 'Closed'][selectedAccount?.status] || '—');
        indicator.textContent = acctNo ? 'Loading service status…' : '';
        indicator.hidden = !acctNo;
        indicator.dataset.accountNumber = acctNo;
        if (!acctNo) return;
        const read = async url => {
            const response = await fetch(url + encodeURIComponent(acctNo));
            if (!response.ok) throw new Error();
            return response.json();
        };
        const [monitoring, financial] = await Promise.allSettled([
            read('/CustomerSupport/DisconnectionStatus?accountNumber='), read('/Billing/AccountLedgerData?accountNumber=')
        ]);
        if (version !== serviceStatusVersion) return;
        const state = monitoring.status === 'fulfilled' && monitoring.value.accountNumber === acctNo ? monitoring.value : null;
        const ledger = financial.status === 'fulfilled' && financial.value.account?.accountNumber === acctNo ? financial.value : null;
        $('ciProfileBalance').textContent = summaryMoney(ledger?.totalBalance ?? state?.totalCollectibleBalance);
        if (!state) { indicator.textContent = 'Service monitoring unavailable. Account and Ledger remain available.'; return; }
        const operational = [...fldMeterStatus.options].find(option => option.textContent === state.operationalAccountStatus);
        if (operational) fldMeterStatus.value = operational.value;
        setBadge('ciOperationalStatus', state.operationalAccountStatus);
        setBadge('ciMonitoringStatus', state.status);
        setBadge('ciPhysicalStatus', state.physicalServiceStatus);
        $('ciDisconnectionDate').textContent = summaryDate(state.actualDisconnectionDateUtc);
        $('ciReconnectionDate').textContent = summaryDate(state.actualReconnectionDateUtc);
        indicator.textContent = '';
        indicator.hidden = true;
    }
    $('ciRefreshService').addEventListener('click', () => refreshServiceStatus(_currentAccountNumber));
    $('ciAccounts').addEventListener('change', event => {
        const account = currentAccounts.find(a => a.accountNumber === event.target.value);
        if (account) switchToAccount(account);
    });
    $('btnBills').addEventListener('click', () => {
        if (!_currentAccountNumber) { showToast('No account selected.', 'error'); return; }
        window.openAccountLedger(_currentAccountNumber, { initialTab: 'bills' });
    });

    // Keep _currentAccountNumber in sync whenever populatePage or switchToAccount fires

    /* ── Adjustments button → opens Adjustments modal ─────────── */
    $('btnAdjustments').addEventListener('click', () => {
        if (!_currentAccountNumber) { showToast('No account selected.', 'error'); return; }
        openAdjModal(_currentAccountNumber);
    });

    /* ── Adjustments modal ──────────────────────────────────────── */
    const URL_DCM_HISTORY = '@Url.Action("GetDebitCreditMemosByAccount", "Billing")';
    const URL_ADJ_HISTORY = '@Url.Action("GetBillAdjustmentsByAccount",  "Billing")';

    let _adjActiveTab = 'dcm';
    let _adjDcmData   = [];
    let _adjAdjData   = [];
    let _adjLoadVersion = 0;

    async function openAdjModal(accountNumber) {
        const version = ++_adjLoadVersion;
        _adjDcmData = []; _adjAdjData = [];
        // Set header label: "LASTNAME, FIRSTNAME  ACCT-NO"
        $('adjCustomerLabel').textContent =
            `${(txtCustomerName.value || '').toUpperCase()}   ${accountNumber}`;

        $('adjModal').classList.remove('adj-hidden');
        document.body.style.overflow = 'hidden';

        // Reset to DCM tab
        switchAdjTab('dcm');

        // Load both tabs in parallel
        try {
            const [dcmRes, adjRes] = await Promise.all([
                fetch(`${URL_DCM_HISTORY}?accountNumber=${encodeURIComponent(accountNumber)}`),
                fetch(`${URL_ADJ_HISTORY}?accountNumber=${encodeURIComponent(accountNumber)}`),
            ]);
            const [dcm, adjustments] = await Promise.all([dcmRes.ok ? dcmRes.json() : [], adjRes.ok ? adjRes.json() : []]);
            if (version !== _adjLoadVersion) return;
            _adjDcmData = dcm; _adjAdjData = adjustments;
        } catch {
            if (version !== _adjLoadVersion) return;
            _adjDcmData = [];
            _adjAdjData = [];
        }

        renderAdjTab(_adjActiveTab);
    }

    function switchAdjTab(tab) {
        _adjActiveTab = tab;
        const isDcm = tab === 'dcm';
        $('adjTabDcm').classList.toggle('adj-tab--active', isDcm);
        $('adjTabAdj').classList.toggle('adj-tab--active', !isDcm);
        $('adjTabDcm').setAttribute('aria-selected', String(isDcm));
        $('adjTabAdj').setAttribute('aria-selected', String(!isDcm));
        $('adjPanelDcm').classList.toggle('adj-hidden', !isDcm);
        $('adjPanelAdj').classList.toggle('adj-hidden', isDcm);
        renderAdjTab(tab);
    }

    function renderAdjTab(tab) {
        if (tab === 'dcm') renderDcmTable(_adjDcmData);
        else               renderAdjTable(_adjAdjData);
    }

    function renderDcmTable(data) {
        const tbody = $('adjDcmBody'); if (!tbody) return;
        tbody.innerHTML = '';
        if (!data.length) {
            tbody.innerHTML = '<tr><td colspan="6" class="adj-empty">No debit/credit memos found.</td></tr>';
            return;
        }
        data.forEach(m => {
            const date    = m.dcmDate ? new Date(m.dcmDate).toLocaleDateString('en-US') : '—';
            const memoCls = m.memoType === 'debit' ? 'adj-memo-debit' : 'adj-memo-credit';
            const memLbl  = (m.memoType || '').toUpperCase();
            const status  = (m.status || 'Pending').toLowerCase();
            const amt     = Number(m.amount || 0).toLocaleString('en-US', { minimumFractionDigits:2 });
            const tr = document.createElement('tr');
            [date, m.dcmType ?? '—', memLbl, '₱' + amt, m.explanation ?? '—', m.status ?? '—'].forEach((value, index) => {
                const td = document.createElement('td'); td.textContent = value;
                if (index === 2) td.className = memoCls;
                if (index === 3) td.className = 'adj-num';
                if (index === 5) {
                    const badge = document.createElement('span'); badge.textContent = value;
                    badge.className = 'adj-status adj-status--' + (['pending', 'approved', 'rejected'].includes(status) ? status : 'pending');
                    td.replaceChildren(badge);
                }
                tr.appendChild(td);
            });
            tbody.appendChild(tr);
        });
    }

    function renderAdjTable(data) {
        const tbody = $('adjAdjBody'); if (!tbody) return;
        tbody.innerHTML = '';
        if (!data.length) {
            tbody.innerHTML = '<tr><td colspan="5" class="adj-empty">No bill adjustments found.</td></tr>';
            return;
        }
        data.forEach(a => {
            const date   = a.dateCreated ? new Date(a.dateCreated).toLocaleDateString('en-US') : '—';
            const period = a.billingPeriod ? new Date(a.billingPeriod).toLocaleDateString('en-US') : '—';
            const amt    = Number(a.amount || 0).toLocaleString('en-US', { minimumFractionDigits:2 });
            const tr = document.createElement('tr');
            [date, a.billingReference ?? '—', period, a.type ?? '—', '₱' + amt].forEach((value, index) => {
                const td = document.createElement('td'); td.textContent = value;
                if (index === 1) td.className = 'adj-mono';
                if (index === 4) td.className = 'adj-num';
                tr.appendChild(td);
            });
            tbody.appendChild(tr);
        });
    }

    $('adjTabDcm').addEventListener('click', () => switchAdjTab('dcm'));
    $('adjTabAdj').addEventListener('click', () => switchAdjTab('adj'));

    $('btnCloseAdj').addEventListener('click', closeAdjModal);
    $('adjModal').addEventListener('click', e => { if (e.target === $('adjModal')) closeAdjModal(); });
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape' && !$('adjModal').classList.contains('adj-hidden')) closeAdjModal();
    });

    function closeAdjModal() {
        ++_adjLoadVersion;
        $('adjModal').classList.add('adj-hidden');
        document.body.style.overflow = '';
    }

    /* ── Seed toolbar state on page-load with customer ── */
    populatePage(SEED);
    fetch('/ZoneBook/GetZones').then(response => {
        if (!response.ok) throw new Error();
        return response.json();
    }).then(data => { zoneBooks = data; renderZoneBook(); })
      .catch(() => { zoneBooks = []; renderZoneBook(); showToast('Zone and Book lookup unavailable.', 'error'); });

})();
</script>
}
