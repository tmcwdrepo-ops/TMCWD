@{
    Layout = "_InsideLayout";
}
@model TMCWD.Application.Models.CustomerViewModel

<div class="p-6 bg-white border border-gray-200 rounded-lg shadow-sm mt-1">
    <h5 class="mb-2 text-2xl font-bold text-gray-900">Customer Details</h5>
    <p class="text-gray-700">
        @using(Html.BeginForm("SaveCustomer", "CustomerSupport"))
        {
            @Html.HiddenFor(x => x.AddEditCustomer.Id)
            @Html.HiddenFor(x => x.AddEditCustomer.DateCreated)
            @Html.HiddenFor(x => x.AddEditCustomer.CreatedBy)
            <div class="grid gap-6 mb-6 md:grid-cols-2">
                <div>
                    @Html.LabelFor(x => x.AddEditCustomer.Firstname, new { @class = "block mb-2.5 text-sm font-medium text-heading" })
                    @Html.TextBoxFor(x => x.AddEditCustomer.Firstname, new { @class = "bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-lg focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body", required = "required", placeholder = "Firstname" })
                </div>
                <div>
                    @Html.LabelFor(x => x.AddEditCustomer.Middlename, new { @class = "block mb-2.5 text-sm font-medium text-heading" })
                    @Html.TextBoxFor(x => x.AddEditCustomer.Middlename, new { @class = "bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-lg focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body", placeholder = "Middlename" })
                </div>
                <div>
                    @Html.LabelFor(x => x.AddEditCustomer.Lastname, new { @class = "block mb-2.5 text-sm font-medium text-heading" })
                    @Html.TextBoxFor(x => x.AddEditCustomer.Lastname, new { @class = "bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-lg focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body", required = "required", placeholder = "Lastname" })
                </div>
                <div>
                    @Html.LabelFor(x => x.AddEditCustomer.PhoneNumber, new { @class = "block mb-2.5 text-sm font-medium text-heading" })
                    @Html.TextBoxFor(x => x.AddEditCustomer.PhoneNumber, new { @class = "bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-lg focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body", required = "required", placeholder = "Phone" })
                </div>
                <div>
                    @Html.LabelFor(x => x.AddEditCustomer.Email, new { @class = "block mb-2.5 text-sm font-medium text-heading" })
                    @Html.TextBoxFor(x => x.AddEditCustomer.Email, new { @class = "bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-lg focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body", type = "email", required = "required", placeholder = "Email" })
                </div>
                <div>
                    @Html.CheckBoxFor(x => x.AddEditCustomer.IsActive, new { @class= "w-4 h-4 border border-default-medium rounded-xs bg-neutral-secondary-medium focus:ring-2 focus:ring-brand-soft", @checked = "checked" })
                    @Html.LabelFor(x => x.AddEditCustomer.IsActive, new { @class = "select-none ms-2 text-sm font-medium text-heading" })
                </div>
            </div>
            <div>
                <button type"submit" class="px-4 py-2 bg-blue-600 text-white font-semibold rounded-md hover:bg-blue-700 transition duration-150">
                    Save
                </button>
                <button type="button" class="px-4 py-2 bg-orange-600 text-black font-semibold rounded-md hover:bg-gray-700 transition duration-150" onclick="location.href='@Url.Action("Index", "CustomerSupport")'">
                    Cancel
                </button>
            </div>
        }
    </p>
</div>

<div class="p-6 bg-white border border-gray-200 rounded-lg shadow-sm mt-1">
    <h5 class="mb-2 text-2xl font-bold text-gray-900">
        Accounts
        <a id="lnkAddAccount" href="#">
            <i class="fa-solid fa-plus"></i>
        </a>
    </h5>
    <p class="text-gray-700">
        <!-- Accounts Table -->
        <table class="border-collapse border border-gray-full w-full ...">
            <thead>
                <tr>
                    <th class="border border-gray-300 p-3 ...">Id #</th>
                    <th class="border border-gray-300 p-3 ...">Account #</th>
                    <th class="border border-gray-300 p-3 ...">Meter #</th>
                    <th class="border border-gray-300 p-3 ...">Address</th>
                    <th class="border border-gray-300 p-3 ...">Current Address</th>
                    <th class="border border-gray-300 p-3 ...">Active</th>
                    <th class="border border-gray-300 p-3 ..."></th>
                </tr>
            </thead>
            <tbody>
                @if(Model.CustomerAccounts == null || Model.CustomerAccounts.Count <= 0)
                {
                    <tr>
                        <td colspan="7" class="text-center border border-gray-300 p-2 ...">
                            No record(s) found . . .
                        </td>
                    </tr>
                }
                else{
                    foreach (var account in Model.CustomerAccounts)
                    {
                        <tr>
                            <td class="border border-gray-300 p-2 ...">@account.Id</td>
                            <td class="border border-gray-300 p-2 ...">@account.AccountNumber</td>
                            <td class="border border-gray-300 p-2 ...">@account.MeterNumber</td>
                            <td class="border border-gray-300 p-2 ...">@account.FullAddress</td>
                            <td class="border border-gray-300 p-2 ...">@(account.IsCurrentAddress ? "Yes" : "No")</td>
                            <td class="border border-gray-300 p-2 ...">@(account.Status.ToString())</td>
                            <td class="border border-gray-300 p-2 ...">
                                <a href="@Url.Action("Index", "Account", new { customerId = Model.AddEditCustomer.Id, accountId = account.Id })" class="text-center text-gray hover:text-blue-600 transition-colors focus:outline-none p-2">
                                    <i class="fa fa-pencil" aria-hidden="true"></i>
                                </a>
                                <a id="lnkShowModal" command="show-modal" data-id="@account.Id" commandfor="deactivateModal" href="#" class="deactivateLink text-center text-gray hover:text-blue-600 transition-colors focus:outline-none p-2">
                                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <!-- End Accounts Table -->
    </p>
</div>
<vc:modal-dialog type="deactivate"></vc:modal-dialog>

