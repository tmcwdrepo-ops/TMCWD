<!-- End Deactivate Modal Window -->

<script type="text/javascript">

    var deactivateLinks = document.getElementsByClassName("deactivateLink");

    [...deactivateLinks].forEach((link) => {
        link.addEventListener("click", (evt) => {
            var accountId = evt.target.parentElement.dataset.id;

            var modal = new ModalDialog({
                type: 'deactivate',
                title: 'Deactivate Customer',
                content: 'Are you sure you want to deactivate customer? All of customer data will be permanently removed. This action cannot be undone.',
                submitCallback: () => {
                    window.location.href = '@Url.Action("DeactivateAccount", "CustomerSupport")' + "?accountId=" + accountId;
                }
            });

            modal.show();

            // showModalDialog({
            //     type: 'deactivate',
            //     submitUrl: '@Url.Action("DeactivateAccount", "CustomerSupport")' + "?accountId=" + accountId,
            //     title: 'Deactivate Customer',
            //     content: 'Are you sure you want to deactivate customer? All of customer data will be permanently removed. This action cannot be undone.'
            // });
        });
    });

    var lnkAddAccount = document.getElementById("lnkAddAccount");
    lnkAddAccount.onclick = function(evt){
        evt.preventDefault();
         
        if(@(Model.AddEditCustomer.Id) > 0)
            window.location.href = '@Url.Action("Index", "Account", new { customerId = Model.AddEditCustomer.Id })';
        else
            var alert = new Alert();
            alert.show({
                type: 'warning',
                content: 'You have to create customer first before adding account(s)'
            });
            // showAlert({
            //     type: 'warning',
            //     content: 'You have to create customer first before adding account(s)'
            // });

    };
</script>