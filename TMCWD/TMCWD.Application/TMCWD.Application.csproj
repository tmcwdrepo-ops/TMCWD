<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Controllers\ReadingController.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.8" />
    <PackageReference Include="System.Resources.Extensions" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TMCWD.Billing\TMCWD.Billing.csproj" />
    <ProjectReference Include="..\TMCWD.Administration\TMCWD.Administration.csproj" />
    <ProjectReference Include="..\TMCWD.CustomerSupport\TMCWD.CustomerSupport.csproj" />
    <ProjectReference Include="..\TMCWD.Engineering\TMCWD.Engineering.csproj" />
    <ProjectReference Include="..\TMCWD.Model\TMCWD.Model.csproj" />
    <ProjectReference Include="..\TMCWD.Services\TMCWD.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
