@{
    Layout = "_InsideLayout";
}
@model TMCWD.Application.Models.AdminViewModel

<div class="p-6 bg-white border border-gray-200 rounded-lg shadow-sm mt-1">
    <h5 class="mb-2 text-2xl font-bold text-gray-900">User Details</h5>
    <p class="text-gray-700">
        @using (Html.BeginForm("SaveUser", "Admin", FormMethod.Post))
        {
            @Html.HiddenFor(x => x.AddEditUser.Id)
            @Html.HiddenFor(x => x.AddEditUser.Password)
            @Html.HiddenFor(x => x.AddEditUser.DateCreated)
            @Html.HiddenFor(x => x.AddEditUser.DateVerified)
            <div class="grid gap-6 mb-6 md:grid-cols-2">
                <div>
                    @Html.LabelFor(x => x.AddEditUser.Name, new { @class = "block mb-2.5 text-sm font-medium text-heading" })
                    @Html.TextBoxFor(x => x.AddEditUser.Name, new { @class = "bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-lg focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body", required = "required", placeholder = "Name" })
                </div>
                <div class="mt-1">
                    @Html.LabelFor(x => x.AddEditUser.Email, new { @class = "block mb-2.5 text-sm font-medium text-heading" })
                    @Html.TextBoxFor(x => x.AddEditUser.Email, new { type = "email", @class = "bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-lg focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body", required = "required", placeholder = "Email" })
                </div>
                <div>
                    @Html.LabelFor(x => x.Password, new { @class = "block mb-2.5 text-sm font-medium text-heading" })
                    @if(Model.AddEditUser.Id > 0)
                    {
                        @Html.TextBoxFor(x => x.Password, new { type = "password", @class = "disabled:bg-slate-50 disabled:text-slate-500 disabled:border-slate-200 disabled:shadow-none", required = "required", placeholder = "Password", disabled = "true" })
                    }
                    else
                    {
                        @Html.TextBoxFor(x => x.Password, new { type = "password", @class = "bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-lg focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body", required = "required", placeholder = "Password" })
                    }
                </div>
                <div>
                    @Html.LabelFor(x => x.ConfirmPassword, new { @class = "block mb-2.5 text-sm font-medium text-heading" })
                    @if(Model.AddEditUser.Id > 0)
                    {
                        @Html.TextBoxFor(x => x.ConfirmPassword, new { type = "password", @class = "disabled:bg-slate-50 disabled:text-slate-500 disabled:border-slate-200 disabled:shadow-none", required = "required", placeholder = "Confirm Password", disabled = "true" })
                    }
                    else
                    {
                        @Html.TextBoxFor(x => x.ConfirmPassword, new { type = "password", @class = "bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-lg focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body", required = "required", placeholder = "Confirm Password" })
                    }
                </div>
                <div>
                    @Html.LabelFor(x => x.AddEditUser.Role, new { @class = "block mb-2.5 text-sm font-medium text-heading" })
                    <select asp-for="AddEditUser.Role" asp-items="Model.Roles" class="mt-1 block w-full rounded-lg border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                    </select>
                    @* <el-dropdown class="inline-block">
                        <button class="inline-flex w-full justify-center gap-x-1.5 rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-xs inset-ring-1 inset-ring-gray-300 hover:bg-gray-50">
                            Role
                            <svg viewBox="0 0 20 20" fill="currentColor" data-slot="icon" aria-hidden="true" class="-mr-1 size-5 text-gray-400">
                                <path d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" fill-rule="evenodd" />
                            </svg>
                        </button>
                    </el-dropdown>

                    <el-menu anchor="bottom end" popover class="w-56 origin-top-right rounded-md bg-white shadow-lg outline-1 outline-black/5 transition transition-discrete [--anchor-gap:--spacing(2)] data-closed:scale-95 data-closed:transform data-closed:opacity-0 data-enter:duration-100 data-enter:ease-out data-leave:duration-75 data-leave:ease-in">
                        <div class="py-1">
                            <a href="#" class="block px-4 py-2 text-sm text-gray-700 focus:bg-gray-100 focus:text-gray-900 focus:outline-hidden">Account settings</a>
                            <a href="#" class="block px-4 py-2 text-sm text-gray-700 focus:bg-gray-100 focus:text-gray-900 focus:outline-hidden">Support</a>
                            <a href="#" class="block px-4 py-2 text-sm text-gray-700 focus:bg-gray-100 focus:text-gray-900 focus:outline-hidden">License</a>
                            <form action="#" method="POST">
                                <button type="button" class="block w-full px-4 py-2 text-left text-sm text-gray-700 focus:bg-gray-100 focus:text-gray-900 focus:outline-hidden">Sign out</button>
                                </form>
                        </div>
                    </el-menu> *@
                </div>
                <div class="flex items-center mb-4">
                    @Html.CheckBoxFor(x => x.AddEditUser.IsActive, new { @class = "w-4 h-4 border border-default-medium rounded-xs bg-neutral-secondary-medium focus:ring-2 focus:ring-brand-soft", required = "required" })
                    @Html.LabelFor(x => x.AddEditUser.IsActive, new { @class = "block mb-2.5 text-sm font-medium text-heading" })
                </div>
            </div>
                
            <button type"submit" class="px-4 py-2 bg-blue-600 text-white font-semibold rounded-md hover:bg-blue-700 transition duration-150">
                Save
            </button>
            <button type="button" class="px-4 py-2 bg-orange-600 text-black font-semibold rounded-md hover:bg-gray-700 transition duration-150" onclick="location.href='@Url.Action("Index", "Admin")'">
                Cancel
            </button>
        }
        
    </p>
</div>