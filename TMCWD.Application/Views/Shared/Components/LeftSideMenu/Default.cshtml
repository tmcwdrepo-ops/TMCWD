@{
}

@model int

<div class="p-6">
    @switch (Model)
    {
        case 1:
            <h1 class="text-2xl font-bold">Administrator</h1>
            break;
        case 2:
            <h1 class="text-2xl font-bold">Customer</h1>
            break;
        case 3:
            <h1 class="text-2xl font-bold">Engineering</h1>
            break;
    }
</div>

<nav class="mt-6">
    @switch ((int)Model)
    {
        case 1:
            <a href="@Url.Action("Index", "Admin")" class="flex items-center px-6 py-3 hover:bg-blue-800">
                <i class="fas fa-home mr-3"></i>User
            </a>
            <a href="@Url.Action("InspectionTypes", "Admin")" class="flex items-center px-6 py-3 hover:bg-blue-800">
                <i class="fas fa-home mr-3"></i>Inspection Type
            </a>
            <a href="@Url.Action("OtherFeeTypes", "Admin")" class="flex items-center px-6 py-3 hover:bg-blue-800">
                <i class="fas fa-home mr-3"></i>Other Fee Type
            </a>
            break;
        case 2:
            <a href="@Url.Action("Index", "CustomerSupport")" class="flex items-center px-6 py-3 hover:bg-blue-800">
                <i class="fas fa-home mr-3"></i>Customers
            </a>
            <a href="@Url.Action("NewConnection", "CustomerSupport")" class="flex items-center px-6 py-3 hover:bg-blue-800">
                <i class="fa-solid fa-faucet-drip mr-3"></i>New Connection
            </a>
            <a href='@Url.Action("Requests", "CustomerSupport")' class="flex items-center px-6 py-3 hover:bg-blue-800">
                <i class="fa fa-ticket mr-3" aria-hidden="true"></i>Requests
            </a>
            break;
        case 3:
            <a href="@Url.Action("Inventory", "Engineering")" class="flex items-center px-6 py-3 hover:bg-blue-800">
                <i class="fas fa-home mr-3"></i>Inventory
            </a>
            break;
    }
    <div class="border-t border-blue-800 my-4"></div>
    <form method="POST" action="{{ route('admin.logout') }}">
        @* @csrf *@
        <input type="hidden" name="token" value="{{ session('admin_auth_token') ?? request('token') }}">
        <button type="submit" class="w-full flex items-center px-6 py-3 hover:bg-blue-800 text-left">
            <i class="fas fa-sign-out-alt mr-3"></i>
            Logout
        </button>
    </form>
</nav>