@{
}

@model TMCWD.Application.Models.CustomerComponentViewModel

@if(Model.Customer.Id > 0)
{
    <p id="@Model.ParagraphId" data-customerid='@Model.Customer.Id' class="@Model.ParagraphClass">@($"{Model.Customer.Firstname} {Model.Customer.Lastname}")</p>
}
else
{
    <p id="@Model.ParagraphId" data-customerid='@Model.Customer.Id' class="@Model.ParagraphClass">No selected customer.</p>
}