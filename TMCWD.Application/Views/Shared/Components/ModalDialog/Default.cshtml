@{
}

@model string

<!-- Deactivate Modal Window -->
@switch(Model){
    @case "deactivate":
        <el-dialog>
            <dialog id="deactivateModal" aria-labelledby="dialogDeactivateTitle" class="deactivate-modal fixed inset-0 size-auto max-h-none max-w-none overflow-y-auto bg-transparent backdrop:bg-transparent">
                <el-dialog-backdrop class="fixed inset-0 bg-gray-500/75 transition-opacity data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in"></el-dialog-backdrop>

                <div tabindex="0" class="flex min-h-full items-end justify-center p-4 text-center focus:outline-none sm:items-center sm:p-0">
                    <el-dialog-panel class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all data-closed:translate-y-4 data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in sm:my-8 sm:w-full sm:max-w-lg data-closed:sm:translate-y-0 data-closed:sm:scale-95">
                        <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                            <div class="sm:flex sm:items-start">
                                <div class="mx-auto flex size-12 shrink-0 items-center justify-center rounded-full bg-red-100 sm:mx-0 sm:size-10">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6 text-red-600">
                                        <path d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </div>
                                <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
                                    <h3 id="dialogDeactivateTitle" class="deactivate-title text-base font-semibold text-gray-900">Deactivate account</h3>
                                    <div class="mt-2">
                                        <p id="dialogDeactivateContent" class="deactivate-content text-sm text-gray-500">Are you sure you want to deactivate your account? All of your data will be permanently removed. This action cannot be undone.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="bg-gray-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
                            <button id="btnSubmitDeactivateDialog" type="button" command="close" commandfor="dialog" class="deactivate-submit inline-flex w-full justify-center rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-red-500 sm:ml-3 sm:w-auto">Deactivate</button>
                            <button id="btnCancelDeactivateDialog" type="button" command="close" commandfor="dialog" class="deactivate-cancel mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-xs inset-ring inset-ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto">Cancel</button>
                        </div>
                    </el-dialog-panel>
                </div>
            </dialog>
        </el-dialog>
        break;

    @case "success":
            <el-dialog>
                <dialog id="successModal" aria-labelledby="dialogSuccessTitle" class="success-modal abcx abcz abdj abdl abdo abdv abei abfp" style="right: var(--el-top-layer-scrollbar-offset, 0px);">
                    <el-dialog-backdrop class="abcx abcz abdz abfn abgb abgc abgd abge abgf" inert=""></el-dialog-backdrop>

                    <div tabindex="0" class="abde abdm abds abdt abel abet abfu abgl abgm">
                        <el-dialog-panel class="abcy abdp abdu abdx abej abeo aber abes abeu abff abfm abga abgb abgc abgd abge abgf abgg abgj abgk abgn abgo abgp">
                            <div>
                                <div class="abda abde abdi abdr abdt abdw abee">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="abdh abfc">
                                        <path d="m4.5 12.75 6 6 9-13.5" stroke-linecap="round" stroke-linejoin="round"></path>
                                    </svg>
                                </div>
                                <div class="abdc abet abgh">
                                    <h3 id="dialogSuccessTitle" class="success-title abev abex abfa">Payment successful</h3>
                                    <div class="abdb">
                                        <p id="dialogSuccessContent" class="success-content abew abez">Lorem ipsum dolor sit amet consectetur adipisicing elit. Consequatur amet labore.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="abdd abgi">
                                <button id="btnCloseSuccessModal" type="button" command="close" commandfor="dialog" class="success-cancel abdg abdn abdt abdy abeh aben abeq abew abex abfd abfg abfs abfv abfw abfy" aria-expanded="true">Go back to dashboard</button>
                            </div>
                        </el-dialog-panel>
                    </div>
                </dialog>
            </el-dialog>
            break;

    @case "number":
        <el-dialog>
            <dialog id="numberModal" aria-labelledby="dialogNumberTitle" class="number-modal fixed inset-0 size-auto max-h-none max-w-none overflow-y-auto bg-transparent backdrop:bg-transparent">
                <el-dialog-backdrop class="fixed inset-0 bg-gray-500/75 transition-opacity data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in"></el-dialog-backdrop>

                <div tabindex="0" class="flex min-h-full items-end justify-center p-4 text-center focus:outline-none sm:items-center sm:p-0">
                    <el-dialog-panel class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all data-closed:translate-y-4 data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in sm:my-8 sm:w-full sm:max-w-lg data-closed:sm:translate-y-0 data-closed:sm:scale-95">
                        <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                            <div class="sm:flex sm:items-start">
                                <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left w-full">
                                    <h3 id="dialogNumberTitle" class="number-title text-base font-semibold text-gray-900">Deactivate account</h3>
                                    <hr class="h-px my-8 bg-gray-600 border-0">
                                    <div class="mt-2">
                                        <p id="dialogNumberContent" class="number-content text-sm text-gray-500">Are you sure you want to deactivate your account? All of your data will be permanently removed. This action cannot be undone.</p>
                                        <p class="text-sm text-gray-500">
                                            <label for="txtQuantity" class="number-text-title block mb-2.5 text-sm font-medium text-heading">New Value</label>
                                            <input id="txtQuantity" type="number" class="number-text bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-lg focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body" required />
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="bg-gray-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
                            <button id="btnSubmitNumberDialog" type="button" command="close" commandfor="dialog" class="number-submit inline-flex w-full justify-center rounded-md bg-green-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-green-500 sm:ml-3 sm:w-auto">Submit</button>
                            <button id="btnCancelNumberDialog" type="button" command="close" commandfor="dialog" class="number-cancel mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-xs inset-ring inset-ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto">Cancel</button>
                        </div>
                    </el-dialog-panel>
                </div>
            </dialog>
        </el-dialog>
        break;
    @case "text":
        <el-dialog>
            <dialog id="textModal" aria-labelledby="dialogTextTitle" class="text-modal fixed inset-0 size-auto max-h-none max-w-none overflow-y-auto bg-transparent backdrop:bg-transparent">
                <el-dialog-backdrop class="fixed inset-0 bg-gray-500/75 transition-opacity data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in"></el-dialog-backdrop>

                <div tabindex="0" class="flex min-h-full items-end justify-center p-4 text-center focus:outline-none sm:items-center sm:p-0">
                    <el-dialog-panel class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all data-closed:translate-y-4 data-closed:opacity-0 data-enter:duration-300 data-enter:ease-out data-leave:duration-200 data-leave:ease-in sm:my-8 sm:w-full sm:max-w-lg data-closed:sm:translate-y-0 data-closed:sm:scale-95">
                        <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                            <div class="sm:flex sm:items-start">
                                <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left w-full">
                                    <h3 id="dialogNumberTitle" class="text-title text-base font-semibold text-gray-900">Deactivate account</h3>
                                    <hr class="h-px my-8 bg-gray-600 border-0">
                                    <div class="mt-2">
                                        <p id="dialogTextContent" class="text-content text-sm text-gray-500">Are you sure you want to deactivate your account? All of your data will be permanently removed. This action cannot be undone.</p>
                                        <p class="text-sm text-gray-500">
                                            <label for="txtText" class="text-text-title block mb-2.5 text-sm font-medium text-heading">New Value</label>
                                            <input id="txtQText" type="text" class="text-text bg-neutral-secondary-medium border border-default-medium text-heading text-sm rounded-lg focus:ring-brand focus:border-brand block w-full px-3 py-2.5 shadow-xs placeholder:text-body" required />
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="bg-gray-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
                            <button id="btnSubmitNumberDialog" type="button" command="close" commandfor="dialog" class="text-submit inline-flex w-full justify-center rounded-md bg-green-600 px-3 py-2 text-sm font-semibold text-white shadow-xs hover:bg-green-500 sm:ml-3 sm:w-auto">Submit</button>
                            <button id="btnCancelNumberDialog" type="button" command="close" commandfor="dialog" class="text-cancel mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-xs inset-ring inset-ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto">Cancel</button>
                        </div>
                    </el-dialog-panel>
                </div>
            </dialog>
        </el-dialog>
        break;
}
<!-- End Number Modal Dialog -->