          FROM `users` AS `u`
          WHERE `u`.`Id` = `r`.`CreatedBy`
          LIMIT 1), '') AS `receivedByName`, CASE
          WHEN `j`.`ReferredToUserId` = -1 THEN 'Billing'
          WHEN `j`.`ReferredToUserId` = -2 THEN 'Maintenance'
          WHEN `j`.`ReferredToUserId` = -3 THEN 'Customer Service'
          ELSE (
              SELECT `u0`.`Name`
              FROM `users` AS `u0`
              WHERE `u0`.`Id` = `j`.`ReferredToUserId`
              LIMIT 1)
      END AS `referredToName`, `j`.`DateReferred` AS `dateReferred`, `r`.`Name` AS `name`, COALESCE(`r`.`Particulars`, '') AS `particulars`, `r`.`Id` AS `requestId`, `j`.`JobOrderNumber` AS `jobOrderNumber`, COALESCE(`j`.`JobOrderDate`, `j`.`DateCreated`) AS `jobOrderDate`, `r`.`AccountNumber` AS `accountNumber`, (
