          LIMIT 1) AS `lastReading`, `r`.`AccountName` AS `accountName`, `r`.`Address` AS `address`, `r`.`ReportedBy` AS `reportedBy`, `r`.`ContactNumber` AS `contactNumber`, `r0`.`JobOrderType` AS `jobOrderType`, `r0`.`JobDescription` AS `jobDescription`, CASE
          WHEN `j`.`Status` = 8 THEN 'Done'
