      INNER JOIN `job_orders` AS `j` ON `r0`.`Id` = CAST(`j`.`RequestDetailId` AS signed)
      WHERE (`r`.`IsServiceRequest` AND (CAST(`j`.`RequestId` AS signed) = `r`.`Id`)) AND (`r0`.`JobDescription` = @__Trim_0)
      ORDER BY COALESCE(`j`.`JobOrderDate`, `j`.`DateCreated`) DESC
